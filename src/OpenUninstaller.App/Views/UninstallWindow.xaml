<Window x:Class="OpenUninstaller.App.Views.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/OpenUninstaller;component/Assets/app.ico"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OpenUninstaller.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:UninstallWorkflowViewModel}"
        Title="{Binding Title}"
        Height="760" Width="820" MinHeight="600" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        Closing="OnClosing"
        Loaded="OnLoaded">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{DynamicResource SidebarBackground}"
            BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="24,18">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="SemiBold" />
          <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,0">
            <Run Text="{Binding Program.Name, Mode=OneWay}" />
            <Run Text=" · " />
            <Run Text="{Binding Program.Version, Mode=OneWay}" />
            <Run Text=" · " />
            <Run Text="{Binding Program.Publisher, Mode=OneWay}" />
          </TextBlock>
        </StackPanel>
        <Button Grid.Column="1" Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                Style="{StaticResource IconButton}" Command="{Binding CloseCommand}"
                AutomationProperties.Name="Close" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="24,20,24,16">

      <!-- Confirm -->
      <ScrollViewer Visibility="{Binding IsConfirmState, Converter={StaticResource BoolVisibility}}"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="Uninstall command" Style="{StaticResource SectionTitle}" />
              <Border Background="{DynamicResource AppBackground}" CornerRadius="7" Padding="12" Margin="0,0,0,10">
                <TextBlock Text="{Binding CommandDisplay}" Style="{StaticResource Mono}" TextWrapping="Wrap" />
              </Border>
              <TextBlock Text="{Binding CommandWarning}" Foreground="{DynamicResource Warning}"
                         Style="{StaticResource Muted}" Margin="0,0,0,10"
                         Visibility="{Binding CommandWarning, Converter={StaticResource TextToVis}}" />
              <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Danger}"
                         Style="{StaticResource Muted}" Margin="0,0,0,10"
                         Visibility="{Binding Error, Converter={StaticResource TextToVis}}" />
              <TextBlock Text="{Binding Program.LocationDisplay}" Style="{StaticResource Muted}" />
              <TextBlock Text="{Binding Program.RegistryPath}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="Options" Style="{StaticResource SectionTitle}" />
              <CheckBox Content="Prefer the quiet uninstall command" IsChecked="{Binding PreferSilent}"
                        Margin="0,0,0,8" />
              <CheckBox Content="Forced uninstall (remove registration only)" IsChecked="{Binding Force}"
                        Margin="0,0,0,4" />
              <TextBlock Style="{StaticResource Muted}"
                         Text="Forced uninstall skips the vendor uninstaller. Use it only when the vendor uninstaller is missing or broken; it cannot remove application files by itself." />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource Danger}" Background="{DynamicResource DangerSoft}">
            <StackPanel>
              <TextBlock Text="What happens next" FontSize="13" FontWeight="SemiBold" />
              <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                         Text="The vendor uninstaller runs first. OpenUninstaller then scans for leftovers and shows every candidate with its evidence. Nothing is deleted until you review the list and confirm. A backup is created automatically before any deletion." />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Running -->
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="460"
                  Visibility="{Binding IsRunningState, Converter={StaticResource BoolVisibility}}">
        <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="34"
                   Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding StatusText}" FontSize="14" FontWeight="SemiBold"
                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,18,0,14" />
        <ProgressBar IsIndeterminate="True" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,14,0,0" TextAlignment="Center"
                   Text="The vendor uninstaller may open its own window. OpenUninstaller waits for it and never terminates it. Do not close this window while the scan is running." />
        <Button Content="Cancel" Style="{StaticResource BaseButton}" Command="{Binding CancelCommand}"
                HorizontalAlignment="Center" Margin="0,18,0,0" />
      </StackPanel>

      <!-- Review -->
      <Grid Visibility="{Binding IsReviewState, Converter={StaticResource BoolVisibility}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="16,13" Margin="0,0,0,10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{Binding ReviewSummary}" FontSize="13" FontWeight="SemiBold" />
              <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" Margin="0,3,0,0" />
              <TextBlock Text="{Binding DiffSummary}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                         TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="Select all allowed" Style="{StaticResource GhostButton}"
                      Command="{Binding SelectAllCommand}" />
              <Button Content="Clear" Style="{StaticResource GhostButton}"
                      Command="{Binding SelectNoneCommand}" />
            </StackPanel>
          </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="2,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding ReviewWarning}" Foreground="{DynamicResource Warning}"
                     FontSize="12" Margin="0,0,12,0" TextWrapping="Wrap" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="Ignore selected" Style="{StaticResource GhostButton}"
                    Command="{Binding IgnoreCommand}" Margin="0,0,6,0" />
            <Button Content="Reset ignored" Style="{StaticResource GhostButton}"
                    Command="{Binding ResetIgnoredCommand}"
                    Visibility="{Binding HasIgnoredEntries, Converter={StaticResource BoolVisibility}}" />
          </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,0,0,14">
                      <TextBlock Text="{Binding Title}" Style="{StaticResource Caption}" Margin="0,0,0,7" />
                      <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="7"
                                    Padding="10" Margin="0,0,0,6">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          IsEnabled="{Binding IsProtected, Converter={StaticResource InverseBool}}"
                                          VerticalAlignment="Top" Margin="0,1,0,0"
                                          ToolTip="{Binding Tooltip}" />
                                <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                  <TextBlock Text="{Binding DisplayPath}" FontSize="12" TextWrapping="Wrap" />
                                  <TextBlock Text="{Binding Reason}" Style="{StaticResource Muted}" Margin="0,3,0,0" />
                                  <TextBlock Text="{Binding ProtectedReason}" FontSize="11"
                                             Foreground="{DynamicResource Warning}" Margin="0,3,0,0"
                                             TextWrapping="Wrap"
                                             Visibility="{Binding ProtectedReason, Converter={StaticResource TextToVis}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                  <Border Style="{StaticResource Badge}">
                                    <TextBlock Text="{Binding ConfidenceLabel}" Style="{StaticResource BadgeText}" />
                                  </Border>
                                  <TextBlock Text="{Binding SizeDisplay}" Style="{StaticResource Caption}"
                                             HorizontalAlignment="Right" Margin="0,5,0,0" />
                                </StackPanel>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding EmptyReviewText}" Style="{StaticResource Muted}" />
            </StackPanel>
          </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center">
            <Run Text="{Binding SelectedSizeLabel, Mode=OneWay}" />
            <Run Text=" selected. A verified backup is created before deletion." />
          </TextBlock>
          <Button Grid.Column="1" Content="Back up and delete selected" Style="{StaticResource DangerButton}"
                  Command="{Binding DeleteCommand}" />
        </Grid>
      </Grid>

      <!-- Result -->
      <ScrollViewer Visibility="{Binding IsResultState, Converter={StaticResource BoolVisibility}}"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel VerticalAlignment="Top">
          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="{Binding ResultSummary}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Danger}" FontSize="12.5"
                         Margin="0,8,0,0" TextWrapping="Wrap"
                         Visibility="{Binding Error, Converter={StaticResource TextToVis}}" />
              <TextBlock Text="{Binding ResultDetail}" Style="{StaticResource Mono}" Margin="0,12,0,0"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Background="{DynamicResource SurfaceAlt}">
            <StackPanel>
              <TextBlock Text="Review database" Style="{StaticResource SectionTitle}" />
              <TextBlock Style="{StaticResource Muted}"
                         Text="A leftover is only deleted after it has been captured in the backup. Restore the backup from the Backups page if an application misbehaves after cleanup." />
              <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="Open backup folder" Style="{StaticResource BaseButton}"
                        Command="{Binding OpenBackupCommand}" Margin="0,0,8,0" />
                <Button Content="Open log" Style="{StaticResource BaseButton}"
                        Command="{Binding OpenLogCommand}" Margin="0,0,8,0" />
                <Button Content="Close" Style="{StaticResource PrimaryButton}"
                        Command="{Binding CloseCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="2" Background="{DynamicResource SidebarBackground}"
            BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="24,10">
      <Grid>
        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Close" Style="{StaticResource BaseButton}" Command="{Binding CloseCommand}"
                  Visibility="{Binding IsRunningState, Converter={StaticResource InverseBoolVisibility}}" />
          <Button Content="Uninstall now" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                  Command="{Binding StartCommand}"
                  Visibility="{Binding IsConfirmState, Converter={StaticResource BoolVisibility}}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
