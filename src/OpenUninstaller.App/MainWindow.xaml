<Window x:Class="OpenUninstaller.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/OpenUninstaller;component/Assets/app.ico"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OpenUninstaller.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="OpenUninstaller"
        Height="800" Width="1280" MinHeight="620" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        Loaded="OnLoaded">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="246" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}"
            BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
      <DockPanel Margin="0,26,0,18">
        <StackPanel DockPanel.Dock="Top" Margin="24,0,20,30">
          <StackPanel Orientation="Horizontal">
            <Viewbox Width="38" Height="38" VerticalAlignment="Center" Margin="0,0,10,0"
                     AutomationProperties.Name="OpenUninstaller">
              <Canvas Width="256" Height="256">
                <Rectangle Width="256" Height="256" RadiusX="42" RadiusY="42" Fill="{DynamicResource Accent}" />
                <Ellipse Canvas.Left="62" Canvas.Top="62" Width="134" Height="134"
                         Stroke="{DynamicResource AccentForeground}" StrokeThickness="30" />
                <Rectangle Canvas.Left="186" Canvas.Top="186" Width="27" Height="27"
                           Fill="{DynamicResource AccentForeground}" />
              </Canvas>
            </Viewbox>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="OpenUninstaller" FontSize="15" FontWeight="SemiBold" />
              <TextBlock Text="APPLICATION MANAGER" FontSize="9" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextMuted}" Margin="1,2,0,0" />
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Margin="16,16,16,0" Padding="14" CornerRadius="12"
                Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0">
                <Ellipse.Style>
                  <Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="{DynamicResource Warning}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding AdminLabel}" Value="Administrator">
                        <Setter Property="Fill" Value="{DynamicResource Success}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
              <TextBlock Text="{Binding AdminLabel}" FontSize="11.5" FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock Text="HKLM cleanup needs elevation." FontSize="10.5"
                       Foreground="{DynamicResource TextMuted}" Margin="0,5,0,0" TextWrapping="Wrap" />
            <TextBlock Text="{Binding VersionLabel}" FontSize="10.5"
                       Foreground="{DynamicResource TextMuted}" Margin="0,6,0,0" />
          </StackPanel>
        </Border>

        <ListBox Style="{StaticResource NavList}"
                 ItemsSource="{Binding NavItems}"
                 SelectedItem="{Binding SelectedNav, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="15"
                           Width="24" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Label}" FontSize="13" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <ContentControl Content="{Binding CurrentPage}" />

      <Border Grid.Row="1" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
              Padding="28,10" Background="{DynamicResource SidebarBackground}">
        <DockPanel LastChildFill="False">
          <TextBlock DockPanel.Dock="Left" Text="{Binding StatusLabel}" FontSize="11" Foreground="{DynamicResource TextMuted}"
                     VerticalAlignment="Center" />
          <TextBlock DockPanel.Dock="Right" Text="{Binding VersionLabel}" FontSize="11"
                     Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
