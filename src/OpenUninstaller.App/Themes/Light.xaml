<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <SolidColorBrush x:Key="AppBackground" Color="#F3F6FA" />
  <SolidColorBrush x:Key="SidebarBackground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SurfaceAlt" Color="#EDF2F8" />
  <SolidColorBrush x:Key="SurfaceHover" Color="#E2EAF3" />
  <SolidColorBrush x:Key="Border" Color="#D7E0EA" />
  <SolidColorBrush x:Key="BorderStrong" Color="#B9C7D6" />
  <SolidColorBrush x:Key="TextPrimary" Color="#15212E" />
  <SolidColorBrush x:Key="TextSecondary" Color="#516476" />
  <SolidColorBrush x:Key="TextMuted" Color="#7C8E9E" />
  <SolidColorBrush x:Key="Accent" Color="#0B6FA4" />
  <SolidColorBrush x:Key="AccentHover" Color="#0E86C4" />
  <SolidColorBrush x:Key="AccentForeground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="AccentSoft" Color="#DCEFFA" />
  <SolidColorBrush x:Key="Danger" Color="#C0362C" />
  <SolidColorBrush x:Key="DangerHover" Color="#D9483D" />
  <SolidColorBrush x:Key="DangerSoft" Color="#FBE7E5" />
  <SolidColorBrush x:Key="Success" Color="#178046" />
  <SolidColorBrush x:Key="Warning" Color="#9A6700" />
  <SolidColorBrush x:Key="SelectionBackground" Color="#DCEFFA" />

  <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Offset="0" Color="#0B6FA4" />
    <GradientStop Offset="1" Color="#0E86C4" />
  </LinearGradientBrush>

</ResourceDictionary>
