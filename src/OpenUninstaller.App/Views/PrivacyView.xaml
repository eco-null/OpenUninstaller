<UserControl x:Class="OpenUninstaller.App.Views.PrivacyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="PrivacyPage"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OpenUninstaller.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PrivacyViewModel}"
             d:DesignHeight="820" d:DesignWidth="1040">

  <Grid Margin="28,26,28,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="Privacy &amp; shredder" Style="{StaticResource PageTitle}" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="960" HorizontalAlignment="Left">

        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
          <StackPanel>
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Text="Shred files permanently" Style="{StaticResource SectionTitle}" />
                <TextBlock Style="{StaticResource Muted}" MaxWidth="640" HorizontalAlignment="Left"
                           Text="Permanent deletion. SSD erasure is not guaranteed." />
              </StackPanel>
              <Border Grid.Row="1" Style="{StaticResource Badge}" HorizontalAlignment="Left" Margin="0,12,0,0">
                <TextBlock Text="No backup" Style="{StaticResource BadgeText}" Foreground="{DynamicResource Warning}" />
              </Border>
            </Grid>

            <WrapPanel Margin="0,16,0,0">
              <Button Content="Add files…" Style="{StaticResource BaseButton}" Command="{Binding AddFilesCommand}"
                      Margin="0,0,8,0" />
              <Button Content="Add folder…" Style="{StaticResource BaseButton}" Command="{Binding AddFolderCommand}"
                      Margin="0,0,8,0" />
              <Button Content="Clear list" Style="{StaticResource GhostButton}" Command="{Binding ClearTargetsCommand}" />
              <TextBlock Text="Passes" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="22,0,8,0" />
              <ComboBox Width="64" ItemsSource="{Binding PassesOptions}" SelectedItem="{Binding Passes, Mode=TwoWay}" />
              <CheckBox Content="Dry run" IsChecked="{Binding ShredDryRun}" Margin="20,0,0,0"
                        VerticalAlignment="Center" />
            </WrapPanel>

            <TextBlock Text="{Binding ShredTargetLabel}" FontSize="12.5" FontWeight="SemiBold" Margin="0,16,0,2" />
            <TextBlock Text="{Binding ShredDetailLabel}" Style="{StaticResource Muted}" Margin="0,0,0,10" />

            <ItemsControl ItemsSource="{Binding ShredTargets}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                          BorderThickness="1" CornerRadius="7" Padding="12,9" Margin="0,0,0,6">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{Binding Label}" FontSize="12.5" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Path}" Style="{StaticResource Mono}"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding Detail}" Style="{StaticResource Caption}"
                                 VerticalAlignment="Center" Margin="12,0" />
                      <Button Grid.Column="2" Content="&#xE711;" Style="{StaticResource IconButton}"
                              ToolTip="Remove from the list"
                              AutomationProperties.Name="Remove from the list"
                              Command="{Binding DataContext.RemoveTargetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="Shred selected targets" Style="{StaticResource DangerButton}"
                    HorizontalAlignment="Left" Margin="0,12,0,0" Command="{Binding ShredCommand}" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
          <StackPanel>
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Text="Windows history and app state" Style="{StaticResource SectionTitle}" />
              </StackPanel>
              <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,14,0,0">
                <Button Content="Scan again" Style="{StaticResource BaseButton}" Command="{Binding ScanCommand}"
                        Margin="0,0,8,0" />
                <Button Content="Select all" Style="{StaticResource BaseButton}" Command="{Binding SelectAllCommand}" />
              </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,10">
              <TextBlock Text="{Binding SelectedLabel}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
              <TextBlock Text=" · " Style="{StaticResource Muted}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding PrivacyTotalLabel}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
              <CheckBox Content="Dry run" IsChecked="{Binding PrivacyDryRun}" Margin="22,0,0,0"
                        VerticalAlignment="Center" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Categories}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                          BorderThickness="1" CornerRadius="7" Padding="12,10" Margin="0,0,0,6">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Top"
                                Margin="0,1,10,0"
                                AutomationProperties.Name="{Binding Title}" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding Warning}" Foreground="{DynamicResource Warning}"
                                   FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding Warning, Converter={StaticResource TextToVis}}" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding ItemLabel}" Style="{StaticResource Caption}"
                                 VerticalAlignment="Center" Margin="12,0" />
                      <TextBlock Grid.Column="3" Text="{Binding SizeDisplay}" Style="{StaticResource Caption}"
                                 VerticalAlignment="Center" MinWidth="58" TextAlignment="Right" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="Clean selected history" Style="{StaticResource DangerButton}"
                    HorizontalAlignment="Left" Margin="0,12,0,0" Command="{Binding CleanCommand}" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
          <StackPanel>
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Text="Browser history and cookies" Style="{StaticResource SectionTitle}" />
              </StackPanel>
              <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,14,0,0">
                <Button Content="Rescan" Style="{StaticResource BaseButton}" Command="{Binding ScanCommand}"
                        Margin="0,0,8,0" />
                <Button Content="Select all" Style="{StaticResource BaseButton}" Command="{Binding SelectAllBrowserCommand}" />
              </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,10">
              <TextBlock Text="{Binding BrowserSelectedLabel}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
              <TextBlock Text=" · " Style="{StaticResource Muted}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding BrowserTotalLabel}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
              <CheckBox Content="Dry run" IsChecked="{Binding BrowserDryRun}" Margin="22,0,0,0"
                        VerticalAlignment="Center" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding BrowserProfiles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                          BorderThickness="1" CornerRadius="7" Padding="12,10" Margin="0,0,0,6">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Top"
                                Margin="0,1,10,0" AutomationProperties.Name="{Binding DisplayName}" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding DisplayName}" FontSize="12.5" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Path}" Style="{StaticResource Mono}"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Caption}"
                                 VerticalAlignment="Center" Margin="12,0" />
                      <TextBlock Grid.Column="3" Text="{Binding SizeDisplay}" Style="{StaticResource Caption}"
                                 VerticalAlignment="Center" MinWidth="58" TextAlignment="Right" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="Clean selected browser data" Style="{StaticResource DangerButton}"
                    HorizontalAlignment="Left" Margin="0,12,0,0" Command="{Binding CleanBrowserCommand}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"
                       Text="Removes history and signs you out. Running browsers are skipped. No backup." />
          </StackPanel>
        </Border>

        <!-- Evidence Remover (Wipe Free Space) -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
          <StackPanel>
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Text="Wipe free space" Style="{StaticResource SectionTitle}" />
                <TextBlock Style="{StaticResource Muted}" MaxWidth="640" HorizontalAlignment="Left"
                           Text="Overwrites free space only; existing files are kept." />
              </StackPanel>
              <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,14,0,0">
                <Button Content="Wipe free space" Style="{StaticResource DangerButton}"
                        Command="{Binding WipeFreeSpaceCommand}"
                        Visibility="{Binding IsWiping, Converter={StaticResource InverseBoolVisibility}}" />
                <Button Content="Cancel wipe" Style="{StaticResource BaseButton}"
                        Command="{Binding CancelWipeCommand}"
                        Visibility="{Binding IsWiping, Converter={StaticResource BoolVisibility}}" />
              </StackPanel>
            </Grid>

            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Select target drive:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableDrives}"
                        SelectedItem="{Binding SelectedDrive, Mode=TwoWay}"
                        IsEnabled="{Binding IsWiping, Converter={StaticResource InverseBool}}"
                        MaxWidth="400" HorizontalAlignment="Left">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Drive.DisplayName}" FontWeight="SemiBold" Margin="0,0,8,0" />
                      <TextBlock Text="{Binding Drive.FreeSpaceDisplay, StringFormat='({0} free)'}" Style="{StaticResource Caption}" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>

            <!-- Wipe In Progress Display -->
            <Border Margin="0,14,0,0" Padding="12" Background="{DynamicResource SurfaceAlt}" CornerRadius="4"
                    Visibility="{Binding IsWiping, Converter={StaticResource BoolVisibility}}">
              <StackPanel>
                <Grid>
                  <TextBlock Text="{Binding WipeProgressStatus}" FontWeight="SemiBold" FontSize="12.5" />
                  <TextBlock Text="{Binding WipeEtaStatus}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                </Grid>
                <ProgressBar Margin="0,8,0,0" Height="8" Minimum="0" Maximum="100" Value="{Binding WipePercent, Mode=OneWay}" />
              </StackPanel>
            </Border>

            <!-- Idle Status / Last Result -->
            <TextBlock Text="{Binding WipeProgressStatus}" Margin="0,10,0,0" Style="{StaticResource Caption}"
                       Visibility="{Binding IsWiping, Converter={StaticResource InverseBoolVisibility}}" />
          </StackPanel>
        </Border>


      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="2" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
      <ProgressBar Grid.Column="1" Width="110" Height="3" IsIndeterminate="True"
                   Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
    </Grid>
  </Grid>
</UserControl>
