<UserControl x:Class="OpenUninstaller.App.Views.ProgramsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OpenUninstaller.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ProgramsViewModel}"
             d:DesignHeight="700" d:DesignWidth="1040">

  <Grid Margin="32,28,32,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,18">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <StackPanel>
        <TextBlock Text="Programs" Style="{StaticResource PageTitle}" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                   Text="Inventory, uninstall, review leftovers. OpenUninstaller runs the vendor uninstaller and never deletes without your approval." />
      </StackPanel>
      <WrapPanel Grid.Row="1" Margin="0,16,0,0">
        <Button Content="{Binding QueueActionLabel}" Style="{StaticResource BaseButton}"
                Command="{Binding QueueUninstallCommand}" Margin="0,0,8,0"
                ToolTip="Review several ticked applications one after another." />
        <Button Content="Clear" Style="{StaticResource GhostButton}"
                Command="{Binding ClearQueueCommand}" Margin="0,0,8,0"
                Visibility="{Binding HasQueue, Converter={StaticResource BoolVisibility}}" />
        <Button Content="Install with tracing" Style="{StaticResource BaseButton}"
                Command="{Binding TraceInstallCommand}" Margin="0,0,8,0"
                ToolTip="Run an installer now and record exactly what it creates." />
        <Button Content="Hunter mode" Style="{StaticResource BaseButton}"
                Command="{Binding HunterCommand}" Margin="0,0,8,0"
                ToolTip="Find the application behind a window on screen." />
        <Button Content="Export" Style="{StaticResource BaseButton}"
                Command="{Binding ExportCommand}" Margin="0,0,8,0" />
        <Button Content="Refresh" Style="{StaticResource PrimaryButton}"
                Command="{Binding RefreshCommand}" />
      </WrapPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="230" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBox Grid.Column="0" Style="{StaticResource SearchInput}" Tag="Search programs…"
               AutomationProperties.Name="Search programs" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
               ToolTip="Search by name, publisher or install location" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
        <TextBlock Text="Filter:" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox ItemsSource="{Binding AvailableFilters}" SelectedItem="{Binding SelectedFilter}" Width="160" />
      </StackPanel>
      <CheckBox Grid.Column="2" Content="Show system components" Margin="16,0,0,0"
                VerticalAlignment="Center" IsChecked="{Binding IncludeSystemComponents}" />
      <TextBlock Grid.Column="3" Text="{Binding CountLabel}" Style="{StaticResource Muted}"
                 VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0" />
    </Grid>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="300" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource Card}" Padding="4">
        <DataGrid Style="{StaticResource DataGridStyle}"
                  ItemsSource="{Binding RowsView}"
                  SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                  MouseDoubleClick="OnRowDoubleClick">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Queue" Width="70">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <CheckBox IsChecked="{Binding IsQueued, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            ToolTip="Add this application to the uninstall queue" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Program" Width="*" MinWidth="260">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="6" Background="{DynamicResource SurfaceAlt}"
                            Margin="0,0,10,0">
                      <Image Source="{Binding Icon}" Width="20" Height="20" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding PublisherDisplay}" FontSize="10.5"
                                 Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Version" Binding="{Binding VersionDisplay}" Width="90" />
            <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Size" Binding="{Binding SizeDisplay}" Width="80" />
            <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Arch" Binding="{Binding ArchitectureDisplay}" Width="70" />
            <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Installed" Binding="{Binding InstallDateDisplay}" Width="88" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
        <Grid>
          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolVisibility}}">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border Width="42" Height="42" CornerRadius="9" Background="{DynamicResource SurfaceAlt}"
                        Margin="0,0,12,0">
                  <Image Source="{Binding SelectedRow.Icon}" Width="30" Height="30" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding SelectedRow.Name}" FontSize="15" FontWeight="SemiBold"
                             TextWrapping="Wrap" />
                  <TextBlock Text="{Binding SelectedRow.PublisherDisplay}" Style="{StaticResource Muted}" />
                </StackPanel>
              </StackPanel>

              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Version" Style="{StaticResource Caption}" Margin="0,0,12,6" />
                <TextBlock Grid.Column="1" Text="{Binding SelectedRow.VersionDisplay}" FontSize="12" Margin="0,0,0,6" />
                <TextBlock Grid.Row="1" Text="Size" Style="{StaticResource Caption}" Margin="0,0,12,6" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedRow.SizeDisplay}" FontSize="12" Margin="0,0,0,6" />
                <TextBlock Grid.Row="2" Text="Registry" Style="{StaticResource Caption}" Margin="0,0,12,0" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedRow.RegistryDisplay}" FontSize="11"
                           Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
              </Grid>

              <TextBlock Text="Install location" Style="{StaticResource Caption}" Margin="0,6,0,4" />
              <TextBlock Text="{Binding SelectedRow.LocationDisplay}" Style="{StaticResource Mono}"
                         TextWrapping="Wrap" Margin="0,0,0,10" />
              <TextBlock Text="Uninstall command" Style="{StaticResource Caption}" Margin="0,0,0,4" />
              <TextBlock Text="{Binding SelectedRow.UninstallDisplay}" Style="{StaticResource Mono}"
                         TextWrapping="Wrap" Margin="0,0,0,16" />

              <Button Content="Uninstall…" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                      Command="{Binding UninstallCommand}" Margin="0,0,0,8" />
              <Button Content="Scan leftovers…" Style="{StaticResource BaseButton}" HorizontalAlignment="Left"
                      Command="{Binding ScanCommand}" Margin="0,0,0,8" />
              <Button Content="Forced uninstall…" Style="{StaticResource BaseButton}" HorizontalAlignment="Left"
                      Command="{Binding ForceUninstallCommand}" />
              <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0"
                         Text="Double-click a row to uninstall. Forced uninstall removes only the registration and then scans for leftovers." />
              <TextBlock Text="{Binding QueueSummary}" Style="{StaticResource Caption}" Margin="0,6,0,0"
                         TextWrapping="Wrap" />
            </StackPanel>
          </ScrollViewer>

          <StackPanel VerticalAlignment="Center"
                      Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolVisibility}}">
            <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="34"
                       Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" />
            <TextBlock Text="Select a program" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"
                       Margin="0,12,0,4" />
            <TextBlock Text="Details and actions appear here." Style="{StaticResource Muted}"
                       HorizontalAlignment="Center" TextAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="3" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <ProgressBar Width="110" Height="3" IsIndeterminate="True"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
