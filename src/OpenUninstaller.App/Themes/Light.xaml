<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Zinc neutrals; semantic colors are reserved for actual state. -->
  <SolidColorBrush x:Key="AppBackground" Color="#F7F7F8" />
  <SolidColorBrush x:Key="SidebarBackground" Color="#FCFCFD" />
  <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SurfaceAlt" Color="#F4F4F5" />
  <SolidColorBrush x:Key="SurfaceHover" Color="#EBEBEE" />
  <SolidColorBrush x:Key="Border" Color="#E4E4E7" />
  <SolidColorBrush x:Key="BorderStrong" Color="#A1A1AA" />
  <SolidColorBrush x:Key="TextPrimary" Color="#18181B" />
  <SolidColorBrush x:Key="TextSecondary" Color="#52525B" />
  <SolidColorBrush x:Key="TextMuted" Color="#62626C" />
  <SolidColorBrush x:Key="Accent" Color="#18181B" />
  <SolidColorBrush x:Key="AccentHover" Color="#3F3F46" />
  <SolidColorBrush x:Key="AccentForeground" Color="#FAFAFA" />
  <SolidColorBrush x:Key="AccentSoft" Color="#EAEAED" />
  <SolidColorBrush x:Key="Danger" Color="#B91C1C" />
  <SolidColorBrush x:Key="DangerHover" Color="#991B1B" />
  <SolidColorBrush x:Key="DangerSoft" Color="#FEF2F2" />
  <SolidColorBrush x:Key="DangerForeground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Success" Color="#047857" />
  <SolidColorBrush x:Key="Warning" Color="#92400E" />
  <SolidColorBrush x:Key="SelectionBackground" Color="#EDEDF0" />
  <SolidColorBrush x:Key="FocusRing" Color="#52525B" />
  <SolidColorBrush x:Key="AccentGradient" Color="#18181B" />
</ResourceDictionary>
