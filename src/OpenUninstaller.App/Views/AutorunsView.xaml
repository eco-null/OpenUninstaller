<UserControl x:Class="OpenUninstaller.App.Views.AutorunsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="AutorunsPage"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OpenUninstaller.App.ViewModels"
             xmlns:infra="clr-namespace:OpenUninstaller.App.Infrastructure"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AutorunsViewModel}"
             d:DesignHeight="700" d:DesignWidth="1040">

  <Grid Margin="28,26,28,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,14">
        <TextBlock Text="Autoruns" Style="{StaticResource PageTitle}" />
        <ListBox ItemsSource="{Binding ModeOptions}" SelectedItem="{Binding SelectedMode, Mode=TwoWay}"
                 Style="{StaticResource ThemeSelector}" HorizontalAlignment="Left" Margin="0,12,0,0"
                 AutomationProperties.Name="Autorun mode"
                 ToolTip="Basic shows application startup entries. Advanced includes Windows system entries." />
      </StackPanel>
      <WrapPanel Grid.Row="1" VerticalAlignment="Center">
        <Button Content="Rollback all" Style="{StaticResource PrimaryButton}" Margin="0,0,12,6"
                Command="{Binding RollbackAllCommand}"
                Visibility="{Binding IsHistoryView, Converter={StaticResource BoolVisibility}}" />
        <TextBlock Text="{Binding CountLabel}" Style="{StaticResource Muted}" VerticalAlignment="Center"
                   Margin="0,0,12,6"
                   Visibility="{Binding IsAutorunsView, Converter={StaticResource BoolVisibility}}" />
        <TextBox Style="{StaticResource SearchInput}" Tag="Search autoruns…" AutomationProperties.Name="Search autoruns" Margin="0,0,10,6"
                 VerticalAlignment="Center"
                 ToolTip="Filter by name, command, source, action or location"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
        <Button Content="Refresh" Style="{StaticResource PrimaryButton}" Command="{Binding RefreshCommand}" Margin="0,0,12,6" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                    Visibility="{Binding IsAutorunsView, Converter={StaticResource BoolVisibility}}">
          <TextBlock Text="Sort by" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
          <ComboBox AutomationProperties.Name="Sort autoruns" Width="230" DisplayMemberPath="Label"
                    ItemsSource="{Binding Sort.Options}" SelectedItem="{Binding Sort.SelectedOption, Mode=TwoWay}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                    Visibility="{Binding IsHistoryView, Converter={StaticResource BoolVisibility}}">
          <TextBlock Text="Sort by" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
          <ComboBox AutomationProperties.Name="Sort autorun history" Width="250" DisplayMemberPath="Label"
                    ItemsSource="{Binding HistorySort.Options}" SelectedItem="{Binding HistorySort.SelectedOption, Mode=TwoWay}" />
        </StackPanel>
      </WrapPanel>
    </Grid>

    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4"
            Visibility="{Binding IsAutorunsView, Converter={StaticResource BoolVisibility}}">
      <DataGrid Style="{StaticResource DataGridStyle}"
                infra:GridSorting.Sort="{Binding Sort}"
                ItemsSource="{Binding EntriesView}"
                SelectedItem="{Binding SelectedEntry, Mode=TwoWay}">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="State" Width="106" SortMemberPath="IsEnabled">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                      <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="{DynamicResource TextMuted}" />
                        <Style.Triggers><DataTrigger Binding="{Binding IsEnabled}" Value="True"><Setter Property="Fill" Value="{DynamicResource Success}" /></DataTrigger></Style.Triggers>
                      </Style>
                    </Ellipse.Style>
                  </Ellipse>
                  <TextBlock Text="{Binding StateLabel}" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Name" Binding="{Binding Name}" Width="180" />
          <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Command" Binding="{Binding Command}" Width="*" />
          <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Source" Binding="{Binding SourceLabel}" Width="130" />
          <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Publisher" Binding="{Binding Publisher}" Width="150" />
          <DataGridTemplateColumn Header="" Width="92" CanUserSort="False">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Button Content="{Binding ToggleLabel}" Style="{StaticResource GhostButton}"
                        Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4"
            Visibility="{Binding IsHistoryView, Converter={StaticResource BoolVisibility}}">
      <DataGrid Style="{StaticResource DataGridStyle}"
                infra:GridSorting.Sort="{Binding HistorySort}"
                ItemsSource="{Binding HistoryView}"
                SelectedItem="{Binding SelectedHistoryEntry, Mode=TwoWay}">
        <DataGrid.Columns>
          <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Timestamp" Binding="{Binding TimestampDisplay}" SortMemberPath="Timestamp" Width="150" />
          <DataGridTemplateColumn Header="Action" Width="120" SortMemberPath="ActionLabel">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Badge}" HorizontalAlignment="Left">
                  <TextBlock Text="{Binding ActionLabel}" Style="{StaticResource BadgeText}" />
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Name" Binding="{Binding Name}" Width="180" />
          <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Source" Binding="{Binding SourceLabel}" Width="130" />
          <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Details" Binding="{Binding Detail}" Width="*" />
          <DataGridTemplateColumn Header="" Width="92" CanUserSort="False">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Button Content="Rollback" Style="{StaticResource GhostButton}"
                        Command="{Binding DataContext.RollbackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        Visibility="{Binding CanRollback, Converter={StaticResource BoolVisibility}}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <Grid Grid.Row="3" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
      <ProgressBar Grid.Column="1" Width="110" Height="3" IsIndeterminate="True"
                   Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
    </Grid>
  </Grid>
</UserControl>
