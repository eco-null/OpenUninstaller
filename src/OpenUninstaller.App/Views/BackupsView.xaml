<UserControl x:Class="OpenUninstaller.App.Views.BackupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="BackupsPage"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OpenUninstaller.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:BackupsViewModel}"
             d:DesignHeight="700" d:DesignWidth="1040">

  <Grid Margin="28,26,28,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <StackPanel>
        <TextBlock Text="Backups" Style="{StaticResource PageTitle}" />
      </StackPanel>
      <WrapPanel Grid.Row="1" Margin="0,16,0,0">
        <TextBlock Text="{Binding CountLabel}" Style="{StaticResource Muted}" VerticalAlignment="Center"
                   Margin="0,0,12,0" />
        <Button Content="Prune old" Style="{StaticResource BaseButton}" Command="{Binding PruneCommand}"
                Margin="0,0,8,0" />
        <Button Content="Refresh" Style="{StaticResource PrimaryButton}" Command="{Binding RefreshCommand}" />
      </WrapPanel>
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4">
      <DataGrid Style="{StaticResource DataGridStyle}"
                ItemsSource="{Binding Backups}"
                SelectedItem="{Binding SelectedBackup, Mode=TwoWay}">
        <DataGrid.Columns>
          <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Program" Binding="{Binding ProgramName}" Width="*" />
          <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Created" Binding="{Binding CreatedDisplay}" Width="150" />
          <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Keys" Binding="{Binding RegistryCount}" Width="70" />
          <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Files" Binding="{Binding FileCount}" Width="70" />
          <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Size" Binding="{Binding TotalBytes, StringFormat={}{0:N0} B}" Width="100" />
          <DataGridTemplateColumn Header="State" Width="120">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Badge}" HorizontalAlignment="Left">
                  <TextBlock Text="{Binding CompletenessLabel}" Style="{StaticResource BadgeText}" />
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,14" Margin="0,14,0,0">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding SelectionSummary}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
          <WrapPanel Margin="0,8,0,0">
            <CheckBox Content="Overwrite existing files when restoring" ToolTip="Existing files are skipped when this is off." IsChecked="{Binding Overwrite}" />
          </WrapPanel>
        </StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,16,0,0">
          <Button Content="Open folder" Style="{StaticResource BaseButton}" Command="{Binding OpenFolderCommand}"
                  Margin="0,0,8,0" />
          <Button Content="Preview…" Style="{StaticResource BaseButton}" Command="{Binding PreviewCommand}"
                  Margin="0,0,8,0" />
          <Button Content="Delete" Style="{StaticResource BaseButton}" Command="{Binding DeleteCommand}"
                  Margin="0,0,8,0" />
          <Button Content="Restore…" Style="{StaticResource PrimaryButton}" Command="{Binding RestoreCommand}" />
        </WrapPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="3" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
      <ProgressBar Grid.Column="1" Width="110" Height="3" IsIndeterminate="True"
                   Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
    </Grid>
  </Grid>
</UserControl>
