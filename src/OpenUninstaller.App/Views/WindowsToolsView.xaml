<UserControl x:Class="OpenUninstaller.App.Views.WindowsToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OpenUninstaller.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:WindowsToolsViewModel}"
             d:DesignHeight="700" d:DesignWidth="1040">

  <Grid Margin="32,28,32,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,18">
      <TextBlock Text="Windows tools" Style="{StaticResource PageTitle}" />
      <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                 Text="Shortcuts to built-in maintenance applets. These launch Windows components; OpenUninstaller does not modify them." />
    </StackPanel>

    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,11" Margin="0,0,0,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBox Style="{StaticResource SearchInput}" Tag="Search tools…" AutomationProperties.Name="Search tools"
                   Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0" />
          <TextBlock Text="Category:" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Width="140" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding CountLabel}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding ToolsView}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Width="290" Margin="0,0,12,10" Padding="14">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,7">
                  <Border Width="30" Height="30" CornerRadius="7" Background="{DynamicResource AccentSoft}"
                          HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="15"
                               Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                  </Border>
                  <Border Style="{StaticResource Badge}" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Category}" Style="{StaticResource BadgeText}" />
                  </Border>
                </Grid>

                <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="2" Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,4,0,8" TextWrapping="Wrap" />

                <StackPanel Grid.Row="3" Orientation="Horizontal">
                  <Button Content="Launch" Style="{StaticResource BaseButton}" HorizontalAlignment="Left"
                          Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}" />
                  <Button Content="Delete" Style="{StaticResource DangerButton}" Margin="8,0,0,0"
                          Visibility="{Binding IsCustom, Converter={StaticResource BooleanToVisibilityConverter}}"
                          Command="{Binding DataContext.RemoveCustomToolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
