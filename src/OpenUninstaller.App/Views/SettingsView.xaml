<UserControl x:Class="OpenUninstaller.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OpenUninstaller.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             d:DesignHeight="760" d:DesignWidth="1040">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,24,28,24" MaxWidth="860" HorizontalAlignment="Left">
      <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
      <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,18"
                 Text="Preferences are stored locally in the OpenUninstaller data directory. Fully offline, no telemetry, zero external network connections." />

      <Border Style="{StaticResource Card}" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Theme" FontSize="13" />
              <TextBlock Text="Dark is the default. The palette applies immediately." Style="{StaticResource Muted}" />
            </StackPanel>
            <ListBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}"
                     SelectedItem="{Binding Theme, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0"
                     HorizontalAlignment="Right" VerticalAlignment="Center">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                  <Setter Property="Cursor" Value="Hand" />
                  <Setter Property="Margin" Value="0,0,6,0" />
                  <Setter Property="AutomationProperties.Name" Value="{Binding}" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="6" Padding="14,7"
                                Background="{DynamicResource SurfaceAlt}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1">
                          <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
            </ListBox>
          </Grid>

          <Border Height="1" Background="{DynamicResource Border}" Margin="0,14,0,14" />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Language / Dil" FontSize="13" />
              <TextBlock Text="Select from 45 international languages. Changes apply immediately." Style="{StaticResource Muted}" />
            </StackPanel>
            <ComboBox Grid.Column="1" ItemsSource="{Binding LanguageOptions}"
                      SelectedItem="{Binding SelectedLanguage}"
                      DisplayMemberPath="Name"
                      Background="{DynamicResource SurfaceAlt}"
                      Foreground="{DynamicResource TextPrimary}"
                      BorderBrush="{DynamicResource Border}"
                      Padding="8,6" VerticalAlignment="Center" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="Windows Explorer integration" Style="{StaticResource SectionTitle}" />
          <CheckBox Content="Add 'Uninstall with OpenUninstaller' to file and folder context menus"
                    IsChecked="{Binding EnableContextMenu}" Margin="0,0,0,4" />
          <TextBlock Text="Adds right-click shortcuts in Windows Explorer for all files, directories, and .lnk shortcuts."
                     Style="{StaticResource Muted}" Margin="24,0,0,0" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="Cleanup behavior" Style="{StaticResource SectionTitle}" />
          <CheckBox Content="Prefer quiet uninstall commands when available" IsChecked="{Binding PreferSilent}"
                    Margin="0,0,0,10" />
          <CheckBox Content="Back up uninstall leftovers before deleting (always on)" IsChecked="True" IsEnabled="False"
                    Margin="0,0,0,4" />
          <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,14" TextWrapping="Wrap"
                     Text="Leftover files, registry keys and values, services and tasks are backed up before deletion and can be restored. Privacy history cleanup and shredding are the deliberate exception: they are irreversible, require a typed confirmation and never copy the removed data into a backup." />
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Keep the newest" FontSize="12.5" VerticalAlignment="Center" />
            <TextBox Style="{StaticResource Input}" Width="72" Margin="10,0"
                     Text="{Binding KeepBackups, UpdateSourceTrigger=LostFocus}" />
            <TextBlock Text="backups when pruning" FontSize="12.5" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Save settings" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" Margin="14,0,0,0"
                       VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="Permissions" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="{Binding AdminText}" Style="{StaticResource Muted}" Margin="0,0,0,12" />
          <Button Content="Restart as administrator" Style="{StaticResource BaseButton}"
                  Command="{Binding ElevateCommand}" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="Local data" Style="{StaticResource SectionTitle}" />
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="90" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Backups" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding BackupPath}" Style="{StaticResource Mono}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="Open" Style="{StaticResource GhostButton}"
                    Command="{Binding OpenBackupsCommand}" />
          </Grid>
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="90" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Traces" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding TracePath}" Style="{StaticResource Mono}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="Open" Style="{StaticResource GhostButton}"
                    Command="{Binding OpenTracesCommand}" />
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="90" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Logs" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding LogPath}" Style="{StaticResource Mono}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="Open" Style="{StaticResource GhostButton}"
                    Command="{Binding OpenLogsCommand}" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="Trace bundles" Style="{StaticResource SectionTitle}" />
          <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap"
                     Text="Move install traces between machines as portable bundles. Known Windows roots become tokens; each bundle carries a SHA-256 hash and is rejected if damaged." />
          <StackPanel Orientation="Horizontal">
            <Button Content="Export all…" Style="{StaticResource BaseButton}"
                    Command="{Binding ExportTracesCommand}" Margin="0,0,8,0" />
            <Button Content="Import bundle…" Style="{StaticResource BaseButton}"
                    Command="{Binding ImportTraceCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="Background maintenance service" Style="{StaticResource SectionTitle}" />
          <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                     Text="Optional Windows service: one pass at startup and then every interval from maintenance.json — backup retention, log and scan-history expiry, and an optional allow-listed junk cleanup. Managing the service needs administrator rights; junk cleaning as LocalSystem follows the same allow-list and guards." />
          <Grid Margin="0,12,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Status:" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Grid.Column="1" Text="{Binding ServiceStatus}" FontSize="12.5" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="Refresh" Style="{StaticResource GhostButton}"
                    HorizontalAlignment="Right" Command="{Binding RefreshServiceCommand}" />
          </Grid>
          <TextBlock Text="{Binding ServiceDetail}" Style="{StaticResource Mono}" TextWrapping="Wrap"
                     TextTrimming="CharacterEllipsis" />
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Install service" Style="{StaticResource BaseButton}"
                    Command="{Binding InstallServiceCommand}" IsEnabled="{Binding IsElevated}"
                    Margin="0,0,8,0" />
            <Button Content="Remove service" Style="{StaticResource BaseButton}"
                    Command="{Binding RemoveServiceCommand}" IsEnabled="{Binding IsElevated}"
                    Margin="0,0,8,0" />
            <Button Content="Run maintenance now" Style="{StaticResource GhostButton}"
                    Command="{Binding RunMaintenanceCommand}" />
          </StackPanel>
          <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0"
                     Text="Install and remove require this app to be running as administrator." />

          <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,14,0,0">
            <StackPanel>
              <TextBlock Text="Maintenance schedule" Style="{StaticResource SectionTitle}" />
              <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                         Text="Saved to maintenance.json and used by the service and “Run maintenance now”. Cleaning junk as LocalSystem follows the same allow-list and guards as the Junk page." />
              <CheckBox Content="Maintenance enabled" IsChecked="{Binding MaintenanceEnabled}" Margin="0,0,0,10" />
              <WrapPanel>
                <StackPanel Margin="0,0,22,10">
                  <TextBlock Text="Interval (minutes)" Style="{StaticResource Caption}" />
                  <TextBox Style="{StaticResource Input}" Width="110"
                           Text="{Binding MaintenanceInterval, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>
                <StackPanel Margin="0,0,22,10">
                  <TextBlock Text="Keep backups" Style="{StaticResource Caption}" />
                  <TextBox Style="{StaticResource Input}" Width="90"
                           Text="{Binding MaintenanceKeepBackups, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>
                <StackPanel Margin="0,0,22,10">
                  <TextBlock Text="Keep logs (days)" Style="{StaticResource Caption}" />
                  <TextBox Style="{StaticResource Input}" Width="90"
                           Text="{Binding MaintenanceLogDays, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>
                <StackPanel Margin="0,0,22,10">
                  <TextBlock Text="Keep scan history (days)" Style="{StaticResource Caption}" />
                  <TextBox Style="{StaticResource Input}" Width="100"
                           Text="{Binding MaintenanceScanDays, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>
              </WrapPanel>
              <CheckBox Content="Clean junk during maintenance" IsChecked="{Binding MaintenanceCleanJunk}"
                        Margin="0,4,0,8" />
              <TextBlock Text="Junk categories (comma separated; empty means none)" Style="{StaticResource Caption}" />
              <TextBox Style="{StaticResource Input}" Margin="0,4,0,10"
                       IsEnabled="{Binding MaintenanceCleanJunk}"
                       Text="{Binding MaintenanceCategories, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,0,0,14">
        <StackPanel>
          <TextBlock Text="Diagnostics" Style="{StaticResource SectionTitle}" />
          <Button Content="Run environment check" Style="{StaticResource BaseButton}"
                  Command="{Binding RunDoctorCommand}" HorizontalAlignment="Left" Margin="0,0,0,10" />
          <TextBox Style="{StaticResource Input}" IsReadOnly="True" MinHeight="90" AcceptsReturn="True"
                   TextWrapping="Wrap" Text="{Binding DoctorSummary, Mode=OneWay}"
                   Visibility="{Binding DoctorSummary, Converter={StaticResource TextToVis}}" />
          <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" Margin="0,8,0,0" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="About" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="{Binding VersionText}" FontSize="13" FontWeight="SemiBold" />
          <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                     Text="MIT licensed, 100% offline open-source implementation with zero network calls and zero telemetry. Clean, independent, and secure." />
          <Button Content="Open documentation" Style="{StaticResource GhostButton}"
                  Command="{Binding OpenDocsCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
