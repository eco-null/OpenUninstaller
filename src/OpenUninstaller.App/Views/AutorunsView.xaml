<UserControl x:Class="OpenUninstaller.App.Views.AutorunsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OpenUninstaller.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AutorunsViewModel}"
             d:DesignHeight="700" d:DesignWidth="1040">

  <Grid Margin="28,24,28,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,24,0">
        <TextBlock Text="Autoruns" Style="{StaticResource PageTitle}" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                   Text="Programs, services and scheduled tasks that start with Windows. Disabling is reversible: the original value, service start mode or task state is recorded locally and can be restored." />
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <Button Content="Active autoruns" Style="{StaticResource BaseButton}"
                  Command="{Binding ShowAutorunsCommand}" Margin="0,0,8,0" Padding="12,5" />
          <Button Content="History &amp; rollback" Style="{StaticResource BaseButton}"
                  Command="{Binding ShowHistoryCommand}" Margin="0,0,8,0" Padding="12,5" />
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
        <Button Content="Rollback all" Style="{StaticResource PrimaryButton}" Margin="0,0,12,0"
                Command="{Binding RollbackAllCommand}"
                Visibility="{Binding IsHistoryView, Converter={StaticResource BoolVisibility}}" />
        <TextBlock Text="{Binding CountLabel}" Style="{StaticResource Muted}" VerticalAlignment="Center"
                   Margin="0,0,12,0"
                   Visibility="{Binding IsAutorunsView, Converter={StaticResource BoolVisibility}}" />
        <TextBlock Text="Filter" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
        <TextBox Width="200" Style="{StaticResource Input}" Margin="0,0,10,0"
                 VerticalAlignment="Center"
                 ToolTip="Filter by name, command, source, action or location"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
        <Button Content="Refresh" Style="{StaticResource PrimaryButton}" Command="{Binding RefreshCommand}" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,11" Margin="0,0,0,14"
            Visibility="{Binding IsAutorunsView, Converter={StaticResource BoolVisibility}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Accent}"
                   FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"
                   Text="Run/RunOnce values, Startup folders, automatic/manual services and scheduled tasks are shown. Boot and system drivers are excluded; disabling a service does not stop an already running process." />
      </Grid>
    </Border>

    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,11" Margin="0,0,0,14"
            Visibility="{Binding IsHistoryView, Converter={StaticResource BoolVisibility}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Accent}"
                   FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"
                   Text="Audit trail of startup items, services, and scheduled tasks modified in OpenUninstaller. Click Rollback on any disabled entry to revert it back to its original enabled startup configuration." />
      </Grid>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4"
            Visibility="{Binding IsAutorunsView, Converter={StaticResource BoolVisibility}}">
      <DataGrid Style="{StaticResource DataGridStyle}"
                ItemsSource="{Binding Entries}"
                SelectedItem="{Binding SelectedEntry, Mode=TwoWay}">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="State" Width="82">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Badge}" HorizontalAlignment="Left">
                  <TextBlock Text="{Binding StateLabel}" Style="{StaticResource BadgeText}" />
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" />
          <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="*" />
          <DataGridTextColumn Header="Source" Binding="{Binding SourceLabel}" Width="130" />
          <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="150" />
          <DataGridTemplateColumn Header="" Width="92">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Button Content="{Binding ToggleLabel}" Style="{StaticResource GhostButton}"
                        Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4"
            Visibility="{Binding IsHistoryView, Converter={StaticResource BoolVisibility}}">
      <DataGrid Style="{StaticResource DataGridStyle}"
                ItemsSource="{Binding HistoryEntries}"
                SelectedItem="{Binding SelectedHistoryEntry, Mode=TwoWay}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Timestamp" Binding="{Binding TimestampDisplay}" Width="150" />
          <DataGridTemplateColumn Header="Action" Width="100">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Badge}" HorizontalAlignment="Left">
                  <TextBlock Text="{Binding ActionLabel}" Style="{StaticResource BadgeText}" />
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" />
          <DataGridTextColumn Header="Source" Binding="{Binding SourceLabel}" Width="130" />
          <DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="*" />
          <DataGridTemplateColumn Header="" Width="92">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Button Content="Rollback" Style="{StaticResource GhostButton}"
                        Command="{Binding DataContext.RollbackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        Visibility="{Binding CanRollback, Converter={StaticResource BoolVisibility}}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <Grid Grid.Row="3" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
      <ProgressBar Grid.Column="1" Width="110" Height="3" IsIndeterminate="True"
                   Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
    </Grid>
  </Grid>
</UserControl>
