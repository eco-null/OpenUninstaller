<UserControl x:Class="OpenUninstaller.App.Views.ProgramsView" x:Name="ProgramsSurface"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="ProgramsPage"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OpenUninstaller.App.ViewModels"
             xmlns:infra="clr-namespace:OpenUninstaller.App.Infrastructure"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ProgramsViewModel}"
             d:DesignHeight="700" d:DesignWidth="1040">

  <Grid Margin="28,26,28,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,18">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <StackPanel>
        <TextBlock Text="Programs" Style="{StaticResource PageTitle}" />
      </StackPanel>
      <WrapPanel Grid.Row="1" Margin="0,18,0,0">
        <Button Content="{Binding QueueActionLabel}" Style="{StaticResource BaseButton}"
                Command="{Binding QueueUninstallCommand}" Margin="0,0,8,6"
                ToolTip="Review several ticked applications one after another." />
        <Button Content="Clear" Style="{StaticResource GhostButton}"
                Command="{Binding ClearQueueCommand}" Margin="0,0,8,6"
                Visibility="{Binding HasQueue, Converter={StaticResource BoolVisibility}}" />
        <Button Content="Install with tracing" Style="{StaticResource BaseButton}"
                Command="{Binding TraceInstallCommand}" Margin="0,0,8,6"
                ToolTip="Run an installer now and record exactly what it creates." />
        <Button Content="Hunter mode" Style="{StaticResource BaseButton}"
                Command="{Binding HunterCommand}" Margin="0,0,8,6"
                ToolTip="Find the application behind a window on screen." />
        <Button Content="Export" Style="{StaticResource BaseButton}"
                Command="{Binding ExportCommand}" Margin="0,0,8,6" />
        <Button Content="Refresh" Style="{StaticResource PrimaryButton}"
                Command="{Binding RefreshCommand}" Margin="0,0,0,6" />
      </WrapPanel>
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBox Style="{StaticResource SearchInput}" Tag="Search by name, publisher or location…" Width="400" HorizontalAlignment="Left"
                   AutomationProperties.Name="Search programs" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Search by name, publisher or install location" />
          <Border Grid.Column="1" Style="{StaticResource Badge}" Margin="16,0,0,0">
            <TextBlock Text="{Binding CountLabel}" Style="{StaticResource BadgeText}" />
          </Border>
        </Grid>
        <WrapPanel Grid.Row="1" Margin="0,12,0,0">
          <StackPanel Orientation="Horizontal" Margin="0,0,20,6">
            <TextBlock Text="Show" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <ComboBox AutomationProperties.Name="Program filter" ItemsSource="{Binding AvailableFilters}" SelectedItem="{Binding SelectedFilter}" Width="170" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,20,6">
            <TextBlock Text="Sort by" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <ComboBox AutomationProperties.Name="Sort programs" Width="230" DisplayMemberPath="Label"
                      ItemsSource="{Binding Sort.Options}" SelectedItem="{Binding Sort.SelectedOption, Mode=TwoWay}" />
          </StackPanel>
          <CheckBox Content="Show system components" Margin="0,0,0,6" VerticalAlignment="Center" IsChecked="{Binding IncludeSystemComponents}" />
        </WrapPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="320" />
        <ColumnDefinition>
          <ColumnDefinition.Style><Style TargetType="ColumnDefinition">
            <Setter Property="Width" Value="16" />
            <Style.Triggers><MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding ActualWidth, ElementName=ProgramsSurface, Converter={StaticResource WidthBelow}, ConverterParameter=1000}" Value="True" />
                <Condition Binding="{Binding HasSelection}" Value="False" />
              </MultiDataTrigger.Conditions>
              <Setter Property="Width" Value="0" />
            </MultiDataTrigger></Style.Triggers>
          </Style></ColumnDefinition.Style>
        </ColumnDefinition>
        <ColumnDefinition>
          <ColumnDefinition.Style><Style TargetType="ColumnDefinition">
            <Setter Property="Width" Value="280" />
            <Setter Property="MinWidth" Value="240" />
            <Setter Property="MaxWidth" Value="420" />
            <Style.Triggers><MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding ActualWidth, ElementName=ProgramsSurface, Converter={StaticResource WidthBelow}, ConverterParameter=1000}" Value="True" />
                <Condition Binding="{Binding HasSelection}" Value="False" />
              </MultiDataTrigger.Conditions>
              <Setter Property="MinWidth" Value="0" />
              <Setter Property="Width" Value="0" />
            </MultiDataTrigger></Style.Triggers>
          </Style></ColumnDefinition.Style>
        </ColumnDefinition>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
        <Grid ClipToBounds="True">
        <DataGrid Style="{StaticResource DataGridStyle}"
                  infra:GridSorting.Sort="{Binding Sort}"
                  ItemsSource="{Binding RowsView}"
                  SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                  MouseDoubleClick="OnRowDoubleClick" ToolTip="Double-click an application to uninstall.">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="" Width="48" CanUserSort="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <CheckBox IsChecked="{Binding IsQueued, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            ToolTip="Add this application to the uninstall queue" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Application" Width="*" MinWidth="180" SortMemberPath="Name">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource SurfaceAlt}"
                            Margin="0,0,10,0">
                      <Image Source="{Binding Icon}" Width="20" Height="20" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding PublisherDisplay}" FontSize="11.5"
                                 Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Version" Binding="{Binding VersionDisplay}" Width="90" />
            <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Size" Binding="{Binding SizeDisplay}" SortMemberPath="Program.EstimatedSizeBytes" Width="80" />
            <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Type" Binding="{Binding ArchitectureDisplay}" Width="70" />
            <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Installed" Binding="{Binding InstallDateDisplay}" SortMemberPath="Program.InstallDate" Width="88" />
          </DataGrid.Columns>
        </DataGrid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20" IsHitTestVisible="False">
          <StackPanel.Style><Style TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers><DataTrigger Binding="{Binding RowsView.IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
          </Style></StackPanel.Style>
          <TextBlock Text="No applications to show" Style="{StaticResource SectionTitle}" TextAlignment="Center" />
          <TextBlock Text="Try a different search or filter, or refresh the inventory." Style="{StaticResource Muted}" TextAlignment="Center" MaxWidth="260" />
        </StackPanel>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="Transparent"
                    ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" VerticalAlignment="Stretch"
                    AutomationProperties.Name="Resize application details" ToolTip="Drag to resize the details panel" />
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
        <Grid>
          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolVisibility}}">
            <StackPanel>
              <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="54" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="9" Background="{DynamicResource SurfaceAlt}"
                        Margin="0,0,12,0">
                  <Image Source="{Binding SelectedRow.Icon}" Width="30" Height="30" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding SelectedRow.Name}" FontSize="15" FontWeight="SemiBold"
                             TextWrapping="Wrap" />
                  <TextBlock Text="{Binding SelectedRow.PublisherDisplay}" Style="{StaticResource Muted}" />
                </StackPanel>
              </Grid>

              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Version" Style="{StaticResource Caption}" Margin="0,0,12,6" />
                <TextBlock Grid.Column="1" Text="{Binding SelectedRow.VersionDisplay}" FontSize="12" Margin="0,0,0,6" />
                <TextBlock Grid.Row="1" Text="Size" Style="{StaticResource Caption}" Margin="0,0,12,6" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedRow.SizeDisplay}" FontSize="12" Margin="0,0,0,6" />

              </Grid>

              <Expander Header="Technical details" Margin="0,6,0,16" Foreground="{DynamicResource TextSecondary}">
                <StackPanel Margin="0,12,0,0">
                  <TextBlock Text="Registry" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                  <TextBlock Text="{Binding SelectedRow.RegistryDisplay}" Style="{StaticResource Mono}" TextWrapping="Wrap" Margin="0,0,0,12" />
              <TextBlock Text="Install location" Style="{StaticResource Caption}" Margin="0,6,0,4" />
              <TextBlock Text="{Binding SelectedRow.LocationDisplay}" Style="{StaticResource Mono}"
                         TextWrapping="Wrap" Margin="0,0,0,10" />
              <TextBlock Text="Uninstall command" Style="{StaticResource Caption}" Margin="0,0,0,4" />
              <TextBlock Text="{Binding SelectedRow.UninstallDisplay}" Style="{StaticResource Mono}"
                         TextWrapping="Wrap" Margin="0,0,0,16" />

                </StackPanel>
              </Expander>
              <Button Content="Uninstall…" Style="{StaticResource DangerButton}" HorizontalAlignment="Left"
                      Command="{Binding UninstallCommand}" Margin="0,0,0,8" />
              <Button Content="Scan leftovers…" Style="{StaticResource BaseButton}" HorizontalAlignment="Left"
                      Command="{Binding ScanCommand}" Margin="0,0,0,8" />
              <Button Content="Forced uninstall…" ToolTip="Removes the registration, then scans for leftovers. Use when normal uninstall is unavailable." Style="{StaticResource BaseButton}" HorizontalAlignment="Left"
                      Command="{Binding ForceUninstallCommand}" />
              <TextBlock Text="{Binding QueueSummary}" Style="{StaticResource Caption}" Margin="0,6,0,0"
                         TextWrapping="Wrap" />
            </StackPanel>
          </ScrollViewer>

          <StackPanel VerticalAlignment="Center"
                      Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolVisibility}}">
            <Border Width="56" Height="56" CornerRadius="14" Background="{DynamicResource SurfaceAlt}" HorizontalAlignment="Center">
              <Path Data="M 3,3 L 25,3 L 25,21 L 3,21 Z M 3,8 L 25,8 M 8,13 L 18,13 M 8,17 L 14,17" Stroke="{DynamicResource TextMuted}" StrokeThickness="1.4" Width="28" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Select a program" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"
                       Margin="0,12,0,4" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="3" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <ProgressBar Width="110" Height="3" IsIndeterminate="True"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
