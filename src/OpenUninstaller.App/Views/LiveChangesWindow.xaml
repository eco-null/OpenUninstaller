<Window x:Class="OpenUninstaller.App.Views.LiveChangesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:infra="clr-namespace:OpenUninstaller.App.Infrastructure"
        Icon="/OpenUninstaller;component/Assets/app.ico"
        Title="{infra:Loc HunterModeLiveSystemActivity}"
        Width="780" Height="520" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI">

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                   Foreground="{DynamicResource Accent}" Margin="0,0,10,0" VerticalAlignment="Center" />
        <TextBlock Text="{infra:Loc LiveActivityLogHunterSession}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
    </StackPanel>

    <TabControl Grid.Row="1" Background="Transparent" BorderBrush="{DynamicResource Border}">
      <TabItem Header="{infra:Loc FileSystemEvents}" FontSize="13">
        <DataGrid Style="{StaticResource DataGridStyle}" x:Name="FileEventsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="Transparent" BorderThickness="0" RowHeaderWidth="0"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource Border}">
          <DataGrid.Columns>
            <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="{infra:Loc Action}" Binding="{Binding KindLabel}" Width="100" />
            <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="{infra:Loc Time}" Binding="{Binding Timestamp, StringFormat='HH:mm:ss'}" Width="80" />
            <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="{infra:Loc Path2}" Binding="{Binding Path}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>

      <TabItem Header="{infra:Loc SpawnedProcesses}" FontSize="13">
        <DataGrid Style="{StaticResource DataGridStyle}" x:Name="ProcessesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="Transparent" BorderThickness="0" RowHeaderWidth="0"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource Border}">
          <DataGrid.Columns>
            <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="PID" Binding="{Binding ProcessId}" Width="70" />
            <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="{infra:Loc Name}" Binding="{Binding ProcessName}" Width="150" />
            <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="{infra:Loc Started}" Binding="{Binding StartTime, StringFormat='HH:mm:ss'}" Width="80" />
            <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="{infra:Loc ExecutablePath}" Binding="{Binding ExecutablePath}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
    </TabControl>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="{infra:Loc Close}" Style="{StaticResource PrimaryButton}" Click="OnCloseClick" Width="90" />
    </StackPanel>
  </Grid>
</Window>
