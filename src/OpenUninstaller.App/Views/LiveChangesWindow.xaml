<Window x:Class="OpenUninstaller.App.Views.LiveChangesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/OpenUninstaller;component/Assets/app.ico"
        Title="Hunter Mode - Live System Activity"
        Width="780" Height="520" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI">

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                   Foreground="{DynamicResource Accent}" Margin="0,0,10,0" VerticalAlignment="Center" />
        <TextBlock Text="Live Activity Log (Hunter Session)" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
    </StackPanel>

    <TabControl Grid.Row="1" Background="Transparent" BorderBrush="{DynamicResource Border}">
      <TabItem Header="File System Events" FontSize="13">
        <DataGrid Style="{StaticResource DataGridStyle}" x:Name="FileEventsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="Transparent" BorderThickness="0" RowHeaderWidth="0"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource Border}">
          <DataGrid.Columns>
            <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Action" Binding="{Binding Kind}" Width="90" />
            <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Time" Binding="{Binding Timestamp, StringFormat='HH:mm:ss'}" Width="80" />
            <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Path" Binding="{Binding Path}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>

      <TabItem Header="Spawned Processes" FontSize="13">
        <DataGrid Style="{StaticResource DataGridStyle}" x:Name="ProcessesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="Transparent" BorderThickness="0" RowHeaderWidth="0"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource Border}">
          <DataGrid.Columns>
            <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="PID" Binding="{Binding ProcessId}" Width="70" />
            <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Name" Binding="{Binding ProcessName}" Width="150" />
            <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Started" Binding="{Binding StartTime, StringFormat='HH:mm:ss'}" Width="80" />
            <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Executable Path" Binding="{Binding ExecutablePath}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
    </TabControl>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="Close" Style="{StaticResource PrimaryButton}" Click="OnCloseClick" Width="90" />
    </StackPanel>
  </Grid>
</Window>
