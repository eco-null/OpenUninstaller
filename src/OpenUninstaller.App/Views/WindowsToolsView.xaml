<UserControl x:Class="OpenUninstaller.App.Views.WindowsToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="WindowsToolsPage"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OpenUninstaller.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:WindowsToolsViewModel}"
             d:DesignHeight="700" d:DesignWidth="1040">

  <Grid Margin="28,26,28,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,18">
      <TextBlock Text="Windows tools" Style="{StaticResource PageTitle}" />
    </StackPanel>

    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,11" Margin="0,0,0,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBox Style="{StaticResource SearchInput}" Tag="Search tools…" AutomationProperties.Name="Search tools"
                   Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0" />
          <TextBlock Text="Category:" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Width="140" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding CountLabel}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding ToolsView}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="18,16">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="42" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="20"
                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="0,0,20,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,5,0,0" />
                  <TextBlock Text="{Binding Category}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="Launch" Style="{StaticResource BaseButton}" AutomationProperties.Name="{Binding Name, StringFormat='Launch {0}'}"
                          Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}" />
                  <Button Content="Delete" Style="{StaticResource DangerButton}" Margin="8,0,0,0"
                          Visibility="{Binding IsCustom, Converter={StaticResource BooleanToVisibilityConverter}}"
                          Command="{Binding DataContext.RemoveCustomToolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
