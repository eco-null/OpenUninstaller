<UserControl x:Class="OpenUninstaller.App.Views.JunkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="JunkPage"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OpenUninstaller.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:JunkViewModel}"
             d:DesignHeight="700" d:DesignWidth="1040">

  <Grid Margin="28,26,28,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <StackPanel>
        <TextBlock Text="Junk files" Style="{StaticResource PageTitle}" />
      </StackPanel>
      <WrapPanel Grid.Row="1" Margin="0,16,0,0">
        <Button Content="Select all" Style="{StaticResource BaseButton}" Command="{Binding SelectAllCommand}"
                Margin="0,0,8,0" />
        <Button Content="Scan again" Style="{StaticResource BaseButton}" Command="{Binding ScanCommand}"
                Margin="0,0,8,0" />
        <Button Content="Clean selected" Style="{StaticResource DangerButton}" Command="{Binding CleanCommand}" />
      </WrapPanel>
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding SelectionLabel}" FontSize="13" FontWeight="SemiBold" />
          <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,0">
            <Run Text="Total reported:" />
            <Run Text="{Binding TotalLabel, Mode=OneWay}" />
            <Run Text=" · " />
            <Run Text="{Binding DryRunLabel, Mode=OneWay}" />
          </TextBlock>
        </StackPanel>
        <CheckBox Grid.Column="1" Content="Dry run" IsChecked="{Binding DryRun}"
                  VerticalAlignment="Center" Margin="0,0,22,0" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Categories}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="18">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanClean}"
                            AutomationProperties.Name="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                            Margin="0,0,10,0" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                  </CheckBox>
                  <Border Grid.Column="1" Style="{StaticResource Badge}">
                    <TextBlock Text="{Binding SizeDisplay}" Style="{StaticResource BadgeText}" />
                  </Border>
                </Grid>
                <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,9,0,10" />
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding ItemLabel}" Style="{StaticResource Caption}" />
                  <TextBlock Text=" · Needs admin" Style="{StaticResource Caption}" Margin="6,0,0,0"
                             Visibility="{Binding RequiresElevation, Converter={StaticResource BoolVisibility}}" />
                </StackPanel>
                <TextBlock Text="Report only in this version." Style="{StaticResource Caption}"
                           Foreground="{DynamicResource Warning}" Margin="0,6,0,0"
                           Visibility="{Binding CanClean, Converter={StaticResource InverseBoolVisibility}}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Grid Grid.Row="3" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
      <ProgressBar Grid.Column="1" Width="110" Height="3" IsIndeterminate="True"
                   Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
    </Grid>
  </Grid>
</UserControl>
