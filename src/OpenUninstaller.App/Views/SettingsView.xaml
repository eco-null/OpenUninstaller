<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:infra="clr-namespace:OpenUninstaller.App.Infrastructure" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="clr-namespace:OpenUninstaller.App.ViewModels" x:Class="OpenUninstaller.App.Views.SettingsView" AutomationProperties.AutomationId="SettingsPage" mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}" d:DesignHeight="760" d:DesignWidth="1040">
  <Grid Margin="28,26,28,28" MaxWidth="1680">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <TextBlock Text="{infra:Loc NavSettings}" Style="{StaticResource PageTitle}" Margin="0,0,0,20"/>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <infra:ResponsiveCardPanel AutomationProperties.AutomationId="SettingsCards" MaxColumns="2" Gap="20">
        <StackPanel AutomationProperties.AutomationId="SettingsPreferences">
          <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Text="{infra:Loc Appearance}" Style="{StaticResource SectionTitle}"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{infra:Loc SettingsTheme}" FontSize="13"/>
                </StackPanel>
                <ListBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme, Mode=TwoWay}"
                         ItemTemplate="{StaticResource LocalizedOption}" Style="{StaticResource ThemeSelector}" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="{infra:Loc ColorTheme}"/>
              </Grid>
              <Border Height="1" Background="{DynamicResource Border}" Margin="0,14,0,14"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{infra:Loc SettingsLanguage}" FontSize="13"/>
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding LanguageOptions}" SelectedValuePath="Id"
                          SelectedValue="{Binding SelectedLanguageId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          AutomationProperties.AutomationId="LanguageSelector" AutomationProperties.Name="{infra:Loc SettingsLanguage}"
                          Background="{DynamicResource SurfaceAlt}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource Border}" Padding="8,6" VerticalAlignment="Center">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
              <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,18,0,0">
                <StackPanel>
                  <TextBlock Text="{infra:Loc WindowsExplorerIntegration}" Style="{StaticResource SectionTitle}"/>
                  <CheckBox Content="{infra:Loc AddExplorerContextMenuShortcuts}" IsChecked="{Binding EnableContextMenu}" Margin="0,0,0,4"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Text="{infra:Loc CleanupBehavior}" Style="{StaticResource SectionTitle}"/>
              <CheckBox Content="{infra:Loc UseSilentUninstallWhenAvailable}" IsChecked="{Binding PreferSilent}" Margin="0,0,0,10"/>
              <CheckBox Content="{infra:Loc AlwaysBackUpUninstallLeftovers}" IsChecked="True" IsEnabled="False" Margin="0,0,0,4"/>
              <DockPanel>
                <TextBox DockPanel.Dock="Right" Style="{StaticResource Input}" Width="72" Margin="10,0,0,0"
                         Text="{Binding KeepBackups, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="{infra:Loc BackupsToKeepWhenPruning}"/>
                <TextBlock Text="{infra:Loc BackupsToKeepWhenPruning}" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center"/>
              </DockPanel>
              <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="{infra:Loc SaveSettings}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"/>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" Margin="14,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
              <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,18,0,0">
                <StackPanel>
                  <TextBlock Text="{infra:Loc Permissions}" Style="{StaticResource SectionTitle}"/>
                  <TextBlock Text="{Binding AdminText}" Style="{StaticResource Muted}" Margin="0,0,0,12"/>
                  <Button Content="{infra:Loc RestartAsAdministrator}" Style="{StaticResource BaseButton}" Command="{Binding ElevateCommand}" HorizontalAlignment="Left"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="{infra:Loc LocalData}" Style="{StaticResource SectionTitle}"/>
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="90"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{infra:Loc NavBackups}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding BackupPath}" Style="{StaticResource Mono}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="{infra:Loc Open}" Style="{StaticResource GhostButton}" Command="{Binding OpenBackupsCommand}"/>
              </Grid>
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="90"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{infra:Loc Traces}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding TracePath}" Style="{StaticResource Mono}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="{infra:Loc Open}" Style="{StaticResource GhostButton}" Command="{Binding OpenTracesCommand}"/>
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="90"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{infra:Loc Logs}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding LogPath}" Style="{StaticResource Mono}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="{infra:Loc Open}" Style="{StaticResource GhostButton}" Command="{Binding OpenLogsCommand}"/>
              </Grid>
              <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,18,0,0">
                <StackPanel>
                  <TextBlock Text="{infra:Loc TraceBundles}" Style="{StaticResource SectionTitle}"/>
                  <StackPanel Orientation="Horizontal">
                    <Button Content="{infra:Loc ExportAll}" Style="{StaticResource BaseButton}" Command="{Binding ExportTracesCommand}" Margin="0,0,8,0"/>
                    <Button Content="{infra:Loc ImportBundle}" Style="{StaticResource BaseButton}" Command="{Binding ImportTraceCommand}"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel AutomationProperties.AutomationId="SettingsMaintenance">
          <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Text="{infra:Loc BackgroundMaintenanceService}" Style="{StaticResource SectionTitle}"/>
              <Grid Margin="0,12,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{infra:Loc Status}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" Text="{Binding ServiceStatus}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="{infra:Loc ActionRefresh}" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Command="{Binding RefreshServiceCommand}"/>
              </Grid>
              <TextBlock Text="{Binding ServiceDetail}" Style="{StaticResource Mono}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
              <WrapPanel Margin="0,12,0,0">
                <Button Content="{infra:Loc UpdateService}" Style="{StaticResource BaseButton}" Command="{Binding UpdateServiceCommand}" IsEnabled="{Binding IsElevated}" Margin="0,0,8,6"
                        Visibility="{Binding ServiceNeedsUpdate, Converter={StaticResource BoolVisibility}}"/>
                <Button Content="{infra:Loc InstallService}" Style="{StaticResource BaseButton}" Command="{Binding InstallServiceCommand}" IsEnabled="{Binding IsElevated}" Margin="0,0,8,6"/>
                <Button Content="{infra:Loc RemoveService}" Style="{StaticResource BaseButton}" Command="{Binding RemoveServiceCommand}" IsEnabled="{Binding IsElevated}" Margin="0,0,8,6"/>
                <Button Content="{infra:Loc RunMaintenanceNow}" Style="{StaticResource GhostButton}" Command="{Binding RunMaintenanceCommand}" Margin="0,0,0,6"/>
              </WrapPanel>
              <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" Text="{infra:Loc AdministratorRequiredToInstallUpdateOrRemove}"/>
              <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,14,0,0">
                <StackPanel>
                  <TextBlock Text="{infra:Loc MaintenanceSchedule}" Style="{StaticResource SectionTitle}"/>
                  <CheckBox Content="{infra:Loc MaintenanceEnabled}" IsChecked="{Binding MaintenanceEnabled}" Margin="0,0,0,10"/>
                  <WrapPanel>
                    <StackPanel Margin="0,0,22,10">
                      <TextBlock Text="{infra:Loc IntervalMinutes}" Style="{StaticResource Caption}"/>
                      <TextBox Style="{StaticResource Input}" Width="110" Text="{Binding MaintenanceInterval, UpdateSourceTrigger=LostFocus}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,22,10">
                      <TextBlock Text="{infra:Loc KeepBackups}" Style="{StaticResource Caption}"/>
                      <TextBox Style="{StaticResource Input}" Width="90" Text="{Binding MaintenanceKeepBackups, UpdateSourceTrigger=LostFocus}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,22,10">
                      <TextBlock Text="{infra:Loc KeepLogsDays}" Style="{StaticResource Caption}"/>
                      <TextBox Style="{StaticResource Input}" Width="90" Text="{Binding MaintenanceLogDays, UpdateSourceTrigger=LostFocus}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,22,10">
                      <TextBlock Text="{infra:Loc KeepScanHistoryDays}" Style="{StaticResource Caption}"/>
                      <TextBox Style="{StaticResource Input}" Width="100" Text="{Binding MaintenanceScanDays, UpdateSourceTrigger=LostFocus}"/>
                    </StackPanel>
                  </WrapPanel>
                  <CheckBox Content="{infra:Loc CleanJunkDuringMaintenance}" IsChecked="{Binding MaintenanceCleanJunk}" Margin="0,4,0,8"/>
                  <TextBlock Text="{infra:Loc JunkCategoriesCommaSeparatedEmptyMeansNone}" Style="{StaticResource Caption}"/>
                  <TextBox Style="{StaticResource Input}" Margin="0,4,0,10" IsEnabled="{Binding MaintenanceCleanJunk}" Text="{Binding MaintenanceCategories, UpdateSourceTrigger=LostFocus}"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="{infra:Loc Diagnostics}" Style="{StaticResource SectionTitle}"/>
              <Button Content="{infra:Loc RunEnvironmentCheck}" Style="{StaticResource BaseButton}" Command="{Binding RunDoctorCommand}" HorizontalAlignment="Left" Margin="0,0,0,10"/>
              <TextBox Style="{StaticResource Input}" IsReadOnly="True" MinHeight="90" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding DoctorSummary, Mode=OneWay}" Visibility="{Binding DoctorSummary, Converter={StaticResource TextToVis}}"/>
              <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
              <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,18,0,0">
                <StackPanel>
                  <TextBlock Text="{infra:Loc About}" Style="{StaticResource SectionTitle}"/>
                  <TextBlock Text="{Binding VersionText}" FontSize="13" FontWeight="SemiBold"/>
                  <Button Content="{infra:Loc OpenDocumentation}" Style="{StaticResource GhostButton}" Command="{Binding OpenDocsCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>
      </infra:ResponsiveCardPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
