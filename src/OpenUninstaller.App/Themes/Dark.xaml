<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <SolidColorBrush x:Key="AppBackground" Color="#0E1319" />
  <SolidColorBrush x:Key="SidebarBackground" Color="#121922" />
  <SolidColorBrush x:Key="Surface" Color="#171F29" />
  <SolidColorBrush x:Key="SurfaceAlt" Color="#1E2833" />
  <SolidColorBrush x:Key="SurfaceHover" Color="#263342" />
  <SolidColorBrush x:Key="Border" Color="#2A3745" />
  <SolidColorBrush x:Key="BorderStrong" Color="#3A4B5E" />
  <SolidColorBrush x:Key="TextPrimary" Color="#E7EEF5" />
  <SolidColorBrush x:Key="TextSecondary" Color="#A7B6C6" />
  <SolidColorBrush x:Key="TextMuted" Color="#74879A" />
  <SolidColorBrush x:Key="Accent" Color="#4CC2FF" />
  <SolidColorBrush x:Key="AccentHover" Color="#74D0FF" />
  <SolidColorBrush x:Key="AccentForeground" Color="#06121B" />
  <SolidColorBrush x:Key="AccentSoft" Color="#123240" />
  <SolidColorBrush x:Key="Danger" Color="#FF6B6B" />
  <SolidColorBrush x:Key="DangerHover" Color="#FF8A8A" />
  <SolidColorBrush x:Key="DangerSoft" Color="#3A1D22" />
  <SolidColorBrush x:Key="Success" Color="#4ADE80" />
  <SolidColorBrush x:Key="Warning" Color="#FBBF24" />
  <SolidColorBrush x:Key="SelectionBackground" Color="#1C3A4A" />

  <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Offset="0" Color="#4CC2FF" />
    <GradientStop Offset="1" Color="#2E8FCF" />
  </LinearGradientBrush>

</ResourceDictionary>
