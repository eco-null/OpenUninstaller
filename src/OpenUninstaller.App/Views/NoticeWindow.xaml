<Window x:Class="OpenUninstaller.App.Views.NoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:OpenUninstaller.App.Infrastructure"
        Icon="/OpenUninstaller;component/Assets/app.ico"
        Width="540" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <TextBlock x:Name="NoticeIcon" FontFamily="Segoe MDL2 Assets" FontSize="19" Margin="0,2,14,0" />
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" MaxHeight="360">
      <TextBlock x:Name="MessageText" FontSize="13" TextWrapping="Wrap" />
    </ScrollViewer>
    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button x:Name="DismissButton" Content="{infra:Loc NoticeNo}" Style="{StaticResource BaseButton}"
              IsCancel="True" Click="OnDismiss" Margin="0,0,8,0" MinWidth="76" />
      <Button x:Name="AcceptButton" Content="{infra:Loc NoticeOk}" Style="{StaticResource PrimaryButton}"
              Click="OnAccept" MinWidth="76" />
    </StackPanel>
  </Grid>
</Window>
