<Window x:Class="OpenUninstaller.App.Views.HunterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/OpenUninstaller;component/Assets/app.ico"
        Title="Hunter mode"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#B3000000"
        Topmost="True"
        WindowState="Maximized"
        ShowInTaskbar="False"
        Cursor="Cross"
        FontFamily="Segoe UI"
        Foreground="{DynamicResource TextPrimary}"
        MouseLeftButtonDown="OnMouseLeftButtonDown"
        KeyDown="OnKeyDown">

  <Grid>
    <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,46,0,0"
            Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Accent}"
            BorderThickness="1" CornerRadius="12" Padding="24,18" MaxWidth="560">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                     Foreground="{DynamicResource Accent}" Margin="0,0,10,0" VerticalAlignment="Center" />
          <TextBlock Text="Hunter mode" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                   Text="Point at any visible window and click it. OpenUninstaller resolves the owning process and matches it to an installed application. It never terminates the process." />
        <Border Margin="0,8,0,0" Padding="8,4" Background="{DynamicResource AccentSoft}" CornerRadius="4" HorizontalAlignment="Left">
          <TextBlock x:Name="TrackingStatusText" Text="Live activity: Tracking active (0 file events, 0 processes)"
                     FontSize="11" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" />
        </Border>
        <TextBlock Text="Esc to cancel · left click to pick a window" FontSize="11"
                   Foreground="{DynamicResource TextMuted}" Margin="0,10,0,0" />
      </StackPanel>
    </Border>

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
      <TextBlock Text="+" FontSize="26" FontFamily="Consolas" Foreground="{DynamicResource Accent}"
                 HorizontalAlignment="Center" />
      <TextBlock Text="Click a window" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                 HorizontalAlignment="Center" Margin="0,8,0,0" />
    </StackPanel>
  </Grid>
</Window>
