root = true

[*]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets,xaml,json,yml,yaml,md}]
indent_size = 2

[*.cs]
# Human-facing sizes, dates and identifiers are formatted for the current UI culture on purpose.
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1309.severity = none

# Services are instance types so they can be composed and substituted in tests even when a
# particular method does not touch state yet.
dotnet_diagnostic.CA1822.severity = suggestion

# P/Invoke declarations intentionally mirror the native signatures.
dotnet_diagnostic.SYSLIB1054.severity = none
