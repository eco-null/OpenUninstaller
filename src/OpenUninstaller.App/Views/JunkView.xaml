<UserControl x:Class="OpenUninstaller.App.Views.JunkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:infra="clr-namespace:OpenUninstaller.App.Infrastructure"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OpenUninstaller.App.ViewModels"
             AutomationProperties.AutomationId="JunkPage"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:JunkViewModel}"
             d:DesignHeight="700" d:DesignWidth="1040">
  <Grid Margin="28,26,28,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="{infra:Loc NavJunk}" Style="{StaticResource PageTitle}" />
      <WrapPanel Margin="0,14,0,0">
        <Button Content="{infra:Loc SelectAll}" Style="{StaticResource BaseButton}" Command="{Binding SelectAllCommand}" Margin="0,0,8,6" />
        <Button Content="{infra:Loc ClearSelection}" Style="{StaticResource BaseButton}" Command="{Binding ClearSelectionCommand}" Margin="0,0,8,6" />
        <Button Content="{infra:Loc ScanAgain}" Style="{StaticResource BaseButton}" Command="{Binding ScanCommand}" Margin="0,0,8,6" />
        <Button Content="{infra:Loc Cancel}" Style="{StaticResource BaseButton}" Command="{Binding CancelCommand}" Margin="0,0,8,6"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
        <Button Content="{infra:Loc CleanSelected}" Style="{StaticResource DangerButton}" Command="{Binding CleanCommand}" Margin="0,0,16,6" />
        <CheckBox Content="{infra:Loc DryRun}" IsChecked="{Binding DryRun}" IsEnabled="{Binding IsNotBusy}" VerticalAlignment="Center" Margin="0,0,0,6" />
      </WrapPanel>
    </StackPanel>

    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,10">
      <Expander Header="{infra:Loc ScanScopeAndRules}" AutomationProperties.Name="{infra:Loc ScanScopeAndRules}">
        <ScrollViewer MaxHeight="285" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,12,8,0" IsEnabled="{Binding IsNotBusy}">
            <CheckBox Content="{infra:Loc KnownSafeTemporaryFoldersAndCaches}" IsChecked="{Binding IncludeKnownLocations}" />
            <TextBlock Text="{infra:Loc AdditionalFoldersAndDrivesAreSearchedByFile}"
                       Style="{StaticResource Muted}" Margin="0,6,0,12" />
            <TextBlock Text="{infra:Loc LocalDrives}" Style="{StaticResource Caption}" Margin="0,0,0,6" />
            <ItemsControl ItemsSource="{Binding Drives}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate>
                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="0,0,18,8" />
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{infra:Loc AdditionalFoldersOneAbsolutePathPerLine}" Style="{StaticResource Caption}" Margin="0,4,0,6" />
            <DockPanel LastChildFill="True">
              <Button DockPanel.Dock="Right" Content="{infra:Loc AddFolder}" Style="{StaticResource BaseButton}" Command="{Binding AddFolderCommand}" Margin="8,0,0,0" VerticalAlignment="Top" />
              <TextBox Text="{Binding FolderPaths, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MaxHeight="90" MinHeight="54"
                       VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{infra:Loc AdditionalScanFolders}" />
            </DockPanel>
            <TextBlock Text="{infra:Loc IncludeFoldersAllFilesReviewOnly}" Style="{StaticResource Caption}" Margin="0,12,0,6" />
            <DockPanel LastChildFill="True">
              <Button DockPanel.Dock="Right" Content="{infra:Loc AddFolder}" AutomationProperties.Name="{infra:Loc AddIncludeFolder}" Style="{StaticResource BaseButton}"
                      Command="{Binding AddIncludedFolderCommand}" Margin="8,0,0,0" VerticalAlignment="Top" />
              <TextBox Text="{Binding IncludedFolderPaths, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MaxHeight="90" MinHeight="54"
                       VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{infra:Loc IncludeAllFilesFromFolders}" />
            </DockPanel>
            <TextBlock Text="{infra:Loc OneAbsolutePathPerLineIncludeFoldersBypass}"
                       Style="{StaticResource Muted}" Margin="0,6,0,0" />
            <TextBlock Text="{infra:Loc FilePatternsSeparateWithSemicolonsAndAreSupported}" Style="{StaticResource Caption}" Margin="0,12,0,6" />
            <DockPanel LastChildFill="True">
              <Button DockPanel.Dock="Right" Content="{infra:Loc ResetDefaults}" Style="{StaticResource BaseButton}" Command="{Binding ResetPatternsCommand}" Margin="8,0,0,0" VerticalAlignment="Top" />
              <TextBox Text="{Binding Patterns, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AutomationProperties.Name="{infra:Loc JunkFilePatterns}" />
            </DockPanel>
            <CheckBox Content="{infra:Loc UseDefaultPatternExclusions}" IsChecked="{Binding UseDefaultExclusions}" Margin="0,12,0,0" />
            <TextBlock Text="{infra:Loc AdditionalExclusionsOnePathOrWildcardPatternPer}" Style="{StaticResource Caption}" Margin="0,12,0,6" />
            <TextBox Text="{Binding ExcludedPaths, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="54" MaxHeight="90"
                     VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{infra:Loc ExcludedJunkPaths}" />
            <CheckBox Content="{infra:Loc FilterPatternMatchesByAge}" IsChecked="{Binding UseAgeFilter}" Margin="0,12,0,0" />
            <WrapPanel Margin="0,8,0,0" IsEnabled="{Binding UseAgeFilter}">
              <TextBlock Text="{infra:Loc PatternMatchMinimumAgeHours}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,6" />
              <ComboBox ItemsSource="{Binding AgeOptions}" SelectedItem="{Binding MinimumAgeHours}" MinWidth="90" Margin="0,0,18,6"
                        AutomationProperties.Name="{infra:Loc MinimumJunkAgeInHours}" />
              <CheckBox Content="{infra:Loc UseLastAccessTime}" IsChecked="{Binding UseLastAccessTime}" VerticalAlignment="Center" Margin="0,0,0,6" />
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
      </Expander>
    </Border>

    <StackPanel Grid.Row="2" Margin="0,0,0,10">
      <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap" Foreground="{DynamicResource Danger}" Margin="0,0,0,8"
                 Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolVisibility}}" />
      <Expander Header="{infra:Loc WarningsAndCleanupDetails}" Foreground="{DynamicResource Warning}"
                Visibility="{Binding HasWarnings, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="{infra:Loc JunkScanWarnings}">
        <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
          <TextBox Text="{Binding WarningText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                   Background="Transparent" Foreground="{DynamicResource TextSecondary}" AutomationProperties.Name="{infra:Loc JunkScanDetails}" />
        </ScrollViewer>
      </Expander>
      <Expander Header="{infra:Loc Categories}" Margin="0,8,0,0">
        <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Categories}" Margin="0,8,0,0" IsEnabled="{Binding IsNotBusy}">
            <ItemsControl.ItemTemplate><DataTemplate>
              <Grid Margin="0,0,0,8" ToolTip="{Binding Description}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <CheckBox Content="{Binding Title}" IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanClean}" AutomationProperties.Name="{Binding Title}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                  <TextBlock Text="{Binding ItemLabel}" Style="{StaticResource Caption}" Margin="0,0,12,0" />
                  <TextBlock Text="{Binding SizeDisplay}" Style="{StaticResource Caption}" />
                </StackPanel>
              </Grid>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Expander>
    </StackPanel>

    <Grid Grid.Row="3" Margin="0,0,0,10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,12,0">
        <TextBlock Text="{Binding SelectionLabel}" FontSize="13" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,0">
          <Run Text="{infra:Loc Reported}" /><Run Text="{Binding TotalLabel, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding DryRunLabel, Mode=OneWay}" />
        </TextBlock>
      </StackPanel>
      <TextBox Grid.Column="1" Style="{StaticResource SearchInput}" Tag="{infra:Loc FilterFiles}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
               AutomationProperties.Name="{infra:Loc FilterJunkFiles}" Width="190" />
    </Grid>

    <Border Grid.Row="4" Style="{StaticResource Card}" Padding="4">
      <Grid>
        <DataGrid Style="{StaticResource DataGridStyle}" ItemsSource="{Binding FilesView}" AutomationProperties.AutomationId="JunkFileGrid"
                  RowHeight="46" IsEnabled="{Binding IsNotBusy}" EnableColumnVirtualization="True">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="" Width="44" CanUserSort="False">
              <DataGridTemplateColumn.CellTemplate><DataTemplate>
                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanClean}"
                          AutomationProperties.Name="{Binding Path}" VerticalAlignment="Center" />
              </DataTemplate></DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="{infra:Loc File}" Width="*" MinWidth="180" SortMemberPath="Path">
              <DataGridTemplateColumn.CellTemplate><DataTemplate>
                <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10,0" ToolTip="{Binding Path}" />
              </DataTemplate></DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="{infra:Loc Size}" Binding="{Binding SizeDisplay}" SortMemberPath="Bytes" ElementStyle="{StaticResource GridText}" Width="90" />
            <DataGridTextColumn Header="{infra:Loc LastModified}" Binding="{Binding ModifiedDisplay}" SortMemberPath="LastWriteUtc" ElementStyle="{StaticResource GridText}" Width="150" />
            <DataGridTemplateColumn Header="{infra:Loc Safety}" Width="120" SortMemberPath="SafetyLabel">
              <DataGridTemplateColumn.CellTemplate><DataTemplate>
                <TextBlock Text="{Binding SafetyLabel}" Style="{StaticResource GridText}" ToolTip="{Binding Reason}" />
              </DataTemplate></DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="{infra:Loc NoFileCandidatesInThisPreviewReviewThe}"
                   TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" IsHitTestVisible="False">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers><MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding HasFiles}" Value="False" />
                  <Condition Binding="{Binding IsBusy}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
              </MultiDataTrigger></Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>
    </Border>

    <Grid Grid.Row="5" Margin="0,10,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,12,0">
        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" />
        <TextBlock Text="{Binding FileCountLabel}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
      </StackPanel>
      <ProgressBar Grid.Column="1" Width="110" Height="3" IsIndeterminate="True" VerticalAlignment="Center"
                   Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
    </Grid>
  </Grid>
</UserControl>
