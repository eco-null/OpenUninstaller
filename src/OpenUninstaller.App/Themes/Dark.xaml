<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Zinc neutrals; semantic colors are reserved for actual state. -->
  <SolidColorBrush x:Key="AppBackground" Color="#09090B" />
  <SolidColorBrush x:Key="SidebarBackground" Color="#101012" />
  <SolidColorBrush x:Key="Surface" Color="#18181B" />
  <SolidColorBrush x:Key="SurfaceAlt" Color="#202023" />
  <SolidColorBrush x:Key="SurfaceHover" Color="#27272A" />
  <SolidColorBrush x:Key="Border" Color="#303034" />
  <SolidColorBrush x:Key="BorderStrong" Color="#66666F" />
  <SolidColorBrush x:Key="TextPrimary" Color="#FAFAFA" />
  <SolidColorBrush x:Key="TextSecondary" Color="#C2C2C9" />
  <SolidColorBrush x:Key="TextMuted" Color="#A1A1AA" />
  <SolidColorBrush x:Key="Accent" Color="#FAFAFA" />
  <SolidColorBrush x:Key="AccentHover" Color="#E4E4E7" />
  <SolidColorBrush x:Key="AccentForeground" Color="#18181B" />
  <SolidColorBrush x:Key="AccentSoft" Color="#27272A" />
  <SolidColorBrush x:Key="Danger" Color="#F87171" />
  <SolidColorBrush x:Key="DangerHover" Color="#FCA5A5" />
  <SolidColorBrush x:Key="DangerSoft" Color="#351D21" />
  <SolidColorBrush x:Key="DangerForeground" Color="#18181B" />
  <SolidColorBrush x:Key="Success" Color="#34D399" />
  <SolidColorBrush x:Key="Warning" Color="#FBBF24" />
  <SolidColorBrush x:Key="SelectionBackground" Color="#29292E" />
  <SolidColorBrush x:Key="FocusRing" Color="#A1A1AA" />
  <SolidColorBrush x:Key="AccentGradient" Color="#FAFAFA" />
</ResourceDictionary>
