<UserControl x:Class="OpenUninstaller.App.Views.StoreAppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="StoreAppsPage"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OpenUninstaller.App.ViewModels"
             xmlns:infra="clr-namespace:OpenUninstaller.App.Infrastructure"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StoreAppsViewModel}"
             d:DesignHeight="700" d:DesignWidth="1040">

  <Grid Margin="28,26,28,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="Store apps" Style="{StaticResource PageTitle}" />
      </StackPanel>
    </Grid>

    <WrapPanel Grid.Row="1" Margin="0,0,0,6">
      <TextBox Style="{StaticResource SearchInput}" Tag="Search apps…" Margin="0,0,12,6"
               AutomationProperties.Name="Search apps" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
               ToolTip="Search by package name, publisher or full name" />
      <Button Content="Refresh" Style="{StaticResource PrimaryButton}"
              Command="{Binding RefreshCommand}" Margin="0,0,16,6" VerticalAlignment="Center" />
      <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
        <TextBlock Text="Sort by" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
        <ComboBox AutomationProperties.Name="Sort store apps" Width="230" DisplayMemberPath="Label"
                  ItemsSource="{Binding Sort.Options}" SelectedItem="{Binding Sort.SelectedOption, Mode=TwoWay}" />
      </StackPanel>
      <TextBlock Text="{Binding CountLabel}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,0,6" />
    </WrapPanel>

    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4">
      <DataGrid Style="{StaticResource DataGridStyle}"
                infra:GridSorting.Sort="{Binding Sort}"
                ItemsSource="{Binding PackagesView}"
                SelectedItem="{Binding SelectedPackage, Mode=TwoWay}">
        <DataGrid.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Uninstall package" Command="{Binding UninstallCommand}" />
            <MenuItem Header="Reset package data" Command="{Binding ResetCommand}" />
            <MenuItem Header="Terminate processes" Command="{Binding TerminateCommand}" />
            <Separator />
            <MenuItem Header="Open package folder" Command="{Binding OpenLocationCommand}" />
            <MenuItem Header="Copy full package name" Command="{Binding CopyNameCommand}" />
          </ContextMenu>
        </DataGrid.ContextMenu>
        <DataGrid.Columns>
          <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Package" Binding="{Binding DisplayName}" Width="*" MinWidth="240" />
          <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Version" Binding="{Binding Version}" Width="110" />
          <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Arch" Binding="{Binding Architecture}" Width="70" />
          <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Kind" Binding="{Binding KindDisplay}" Width="90" />
          <DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Publisher" Binding="{Binding Publisher}" Width="220" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16"
            Visibility="{Binding HasSelection, Converter={StaticResource BoolVisibility}}">
      <StackPanel>
        <TextBlock Text="{Binding SelectedPackage.DisplayName}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding SelectedPackage.PackageFullName}" Style="{StaticResource Mono}"
                   TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11.5" />
        <TextBlock Text="{Binding SelectedPackage.InstallLocation}" Style="{StaticResource Muted}"
                   TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11.5" />
        <WrapPanel Margin="0,12,0,0">
          <Button Content="Uninstall" Style="{StaticResource DangerButton}"
                  Command="{Binding UninstallCommand}" Margin="0,0,8,4"
                  ToolTip="Remove this package for the current user" />
          <Button Content="Reset" Style="{StaticResource BaseButton}"
                  Command="{Binding ResetCommand}" Margin="0,0,8,4" ToolTip="Reset app data and state" />
          <Button Content="Terminate" Style="{StaticResource BaseButton}"
                  Command="{Binding TerminateCommand}" Margin="0,0,8,4" ToolTip="Terminate running processes" />
          <Button Content="Open folder" Style="{StaticResource GhostButton}"
                  Command="{Binding OpenLocationCommand}" Margin="0,0,8,4" />
          <Button Content="Copy name" Style="{StaticResource GhostButton}"
                  Command="{Binding CopyNameCommand}" Margin="0,0,0,4" />
        </WrapPanel>
      </StackPanel>
    </Border>

    <Grid Grid.Row="4" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
      <ProgressBar Grid.Column="1" Width="110" Height="3" IsIndeterminate="True"
                   Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
    </Grid>
  </Grid>
</UserControl>
