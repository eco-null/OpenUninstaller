<Window x:Class="OpenUninstaller.App.Views.HunterActionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:infra="clr-namespace:OpenUninstaller.App.Infrastructure"
        Icon="/OpenUninstaller;component/Assets/app.ico"
        Title="{infra:Loc HunterModeTargetAction}"
        Width="580" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI">

  <Border Padding="24">
    <StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
        <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentSoft}" Margin="0,0,12,0">
          <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                     Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="TargetTitle" FontSize="16" FontWeight="SemiBold" Text="{infra:Loc TargetProcess}" />
          <TextBlock x:Name="TargetSubtitle" Style="{StaticResource Muted}" Text="{infra:Loc ResolvedApplication}" />
        </StackPanel>
      </StackPanel>

      <Border Style="{StaticResource Card}" Margin="0,4,0,16" Padding="14">
        <StackPanel>
          <TextBlock x:Name="ExecutableLabel" Text="{infra:Loc Path}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextMuted}" />
          <TextBlock x:Name="ExecutableText" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,8" />

          <TextBlock Text="{infra:Loc ProcessID}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextMuted}" />
          <TextBlock x:Name="PidText" FontSize="12" Margin="0,2,0,8" />

          <Border Height="1" Background="{DynamicResource Border}" Margin="0,4,0,8" />
          <TextBlock x:Name="LiveStatsText" FontSize="11" Foreground="{DynamicResource Accent}"
                     Text="{infra:Loc LiveTracking0FileEvents0ProcessesRecorded}" />
        </StackPanel>
      </Border>

      <StackPanel Margin="0,0,0,8">
        <Button Content="{infra:Loc UninstallWithOpenUninstaller}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8"
                Padding="12,10" Click="OnUninstallClick" HorizontalContentAlignment="Center" />

        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Content="{infra:Loc StopProcess}" Style="{StaticResource BaseButton}"
                  Padding="8,8" Click="OnKillProcessClick" />
          <Button Grid.Column="2" Content="{infra:Loc StopDelete}" Style="{StaticResource DangerButton}"
                  Padding="8,8" Click="OnKillDeleteClick" />
        </Grid>

        <Grid Margin="0,0,0,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Content="{infra:Loc OpenContainingFolder}" Style="{StaticResource BaseButton}"
                  Padding="8,8" Click="OnOpenFolderClick" />
          <Button Grid.Column="2" Content="{infra:Loc ViewLiveChanges}" Style="{StaticResource BaseButton}"
                  Padding="8,8" Click="OnViewChangesClick" />
        </Grid>

        <Button Content="{infra:Loc Cancel}" Style="{StaticResource BaseButton}" Padding="8,8"
                Click="OnCancelClick" HorizontalAlignment="Right" Width="100" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
