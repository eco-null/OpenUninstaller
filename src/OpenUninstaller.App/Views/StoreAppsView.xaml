<UserControl x:Class="OpenUninstaller.App.Views.StoreAppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OpenUninstaller.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StoreAppsViewModel}"
             d:DesignHeight="700" d:DesignWidth="1040">

  <Grid Margin="28,24,28,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="Store apps" Style="{StaticResource PageTitle}" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" MaxWidth="760" HorizontalAlignment="Left"
                   Text="Inventory, uninstall, and reset Microsoft Store and MSIX packages for this user." />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
        <Button Content="Refresh" Style="{StaticResource PrimaryButton}" Command="{Binding RefreshCommand}" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="340" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox Style="{StaticResource Input}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
               ToolTip="Search by package name, publisher or full name" />
      <TextBlock Grid.Column="1" Text="{Binding CountLabel}" Style="{StaticResource Muted}"
                 VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0" />
    </Grid>

    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4">
      <DataGrid Style="{StaticResource DataGridStyle}"
                ItemsSource="{Binding PackagesView}"
                SelectedItem="{Binding SelectedPackage, Mode=TwoWay}">
        <DataGrid.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Uninstall package" Command="{Binding UninstallCommand}" />
            <MenuItem Header="Reset package data" Command="{Binding ResetCommand}" />
            <MenuItem Header="Terminate processes" Command="{Binding TerminateCommand}" />
            <Separator />
            <MenuItem Header="Open package folder" Command="{Binding OpenLocationCommand}" />
            <MenuItem Header="Copy full package name" Command="{Binding CopyNameCommand}" />
          </ContextMenu>
        </DataGrid.ContextMenu>
        <DataGrid.Columns>
          <DataGridTextColumn Header="Package" Binding="{Binding DisplayName}" Width="*" MinWidth="240" />
          <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="110" />
          <DataGridTextColumn Header="Arch" Binding="{Binding Architecture}" Width="70" />
          <DataGridTextColumn Header="Kind" Binding="{Binding KindDisplay}" Width="90" />
          <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="220" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16"
            Visibility="{Binding HasSelection, Converter={StaticResource BoolVisibility}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="{Binding SelectedPackage.DisplayName}" FontSize="15" FontWeight="SemiBold" />
          <TextBlock Text="{Binding SelectedPackage.PackageFullName}" Style="{StaticResource Mono}"
                     TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11.5" />
          <TextBlock Text="{Binding SelectedPackage.InstallLocation}" Style="{StaticResource Muted}"
                     TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11.5" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
          <Button Content="Uninstall" Style="{StaticResource DangerButton}"
                  Command="{Binding UninstallCommand}" Margin="0,0,8,0"
                  ToolTip="Remove this package for the current user" />
          <Button Content="Reset" Style="{StaticResource BaseButton}"
                  Command="{Binding ResetCommand}" Margin="0,0,8,0"
                  ToolTip="Reset app data and state" />
          <Button Content="Terminate" Style="{StaticResource BaseButton}"
                  Command="{Binding TerminateCommand}" Margin="0,0,8,0"
                  ToolTip="Terminate running processes" />
          <Button Content="Open folder" Style="{StaticResource GhostButton}"
                  Command="{Binding OpenLocationCommand}" Margin="0,0,8,0" />
          <Button Content="Copy name" Style="{StaticResource GhostButton}"
                  Command="{Binding CopyNameCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="4" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
      <ProgressBar Grid.Column="1" Width="110" Height="3" IsIndeterminate="True"
                   Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
    </Grid>
  </Grid>
</UserControl>
